<%- include('partials/header') %>

<section class="static-hero" aria-labelledby="contact-heading">
  <div class="container">
    <div class="static-hero-content">
      <span class="section-label">Contact Us</span>
      <h1 id="contact-heading">We're Here to Help</h1>
      <p class="static-hero-sub">Whether you have questions about test series, need technical support, or want to partner with us — reach out and we'll respond within 24 hours.</p>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="contact-info-heading">
  <div class="container">
    <div class="contact-layout">
      <!-- Contact cards -->
      <div class="contact-cards-col">
        <h2 id="contact-info-heading" class="sr-only">Contact Information</h2>

        <div class="contact-card">
          <div class="contact-card-icon" aria-hidden="true">✉️</div>
          <div>
            <h3>Email Support</h3>
            <p>For account queries, test access issues, or general support, email us and we'll get back to you within 24 hours.</p>
            <a href="mailto:i.mockorbit@gmail.com" class="contact-link">i.mockorbit@gmail.com</a>
          </div>
        </div>

        <div class="contact-card">
          <div class="contact-card-icon" aria-hidden="true">📞</div>
          <div>
            <h3>Phone Support</h3>
            <p>Available Monday to Saturday, 9 AM – 6 PM IST. For urgent issues, calling is the fastest way to reach us.</p>
            <a href="tel:+919654687526" class="contact-link">+91 96546 87526</a>
          </div>
        </div>

        <div class="contact-card">
          <div class="contact-card-icon" aria-hidden="true">🏛️</div>
          <div>
            <h3>Institution Partnerships</h3>
            <p>Want to offer MockOrbit tests to your students? Our org plan gives you full control over assignments and results.</p>
            <a href="/org/register" class="contact-link">Register as Institution →</a>
          </div>
        </div>

        <div class="contact-card">
          <div class="contact-card-icon" aria-hidden="true">📍</div>
          <div>
            <h3>Office Address</h3>
            <p>MockOrbit Technologies Pvt. Ltd.<br>Plot No.-462, Shakti Khand-4,<br>Indirapuram, Ghaziabad, U.P. 201014</p>
          </div>
        </div>
      </div>

      <!-- Quick contact form (frontend-only, opens email) -->
      <div class="contact-form-col">
        <div class="card" style="padding: 36px;">
          <h2 style="margin-bottom:8px; font-size:1.4rem;">Send us a Message</h2>
          <p style="margin-bottom:28px; font-size:0.9rem;">Fill in the form below and we'll respond by email.</p>

          <div id="contactFormMsg" class="alert hidden" role="alert" aria-live="polite"></div>

          <div class="form-group">
            <label class="form-label" for="cf-name">Your Name</label>
            <input class="form-control" type="text" id="cf-name" placeholder="Rahul Sharma" autocomplete="name">
          </div>
          <div class="form-group">
            <label class="form-label" for="cf-email">Email Address</label>
            <input class="form-control" type="email" id="cf-email" placeholder="rahul@example.com" autocomplete="email">
          </div>
          <div class="form-group">
            <label class="form-label" for="cf-subject">Subject</label>
            <select class="form-control" id="cf-subject">
              <option value="">Select a topic</option>
              <option value="Account or Login Issue">Account or Login Issue</option>
              <option value="Test Access Problem">Test Access Problem</option>
              <option value="Payment or Refund">Payment or Refund</option>
              <option value="Institute Partnership">Institute Partnership</option>
              <option value="Technical Bug">Technical Bug</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="cf-msg">Message</label>
            <textarea class="form-control" id="cf-msg" rows="5" placeholder="Describe your issue or question in detail..."></textarea>
          </div>
          <button class="btn btn-primary btn-block" id="contactSubmitBtn" type="button">Send Message →</button>
          <p class="text-muted text-small" style="margin-top:12px; text-align:center;">We typically respond within 24 hours on business days.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ Section -->
<section class="section bg-soft" aria-labelledby="faq-heading">
  <div class="container container-sm">
    <div class="section-heading">
      <span class="section-label">Quick Answers</span>
      <h2 id="faq-heading">Frequently Asked Questions</h2>
    </div>
    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">How do I access purchased test series?</button>
        <div class="faq-a">After payment, the test series appears under <strong>My Dashboard → My Tests</strong>. If you don't see it within 10 minutes, email us with your payment reference.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">Can I attempt a test on mobile?</button>
        <div class="faq-a">Yes, MockOrbit is fully responsive. We recommend using Chrome or Safari on mobile for the best test-taking experience.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">How do I register my institute?</button>
        <div class="faq-a">Visit <a href="/org/register">For Institutes</a>, fill in your organisation details, and our team will review and activate your account within 48 hours.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">Is my payment information secure?</button>
        <div class="faq-a">Yes. Payments are processed through Razorpay, which is PCI-DSS compliant. MockOrbit never stores your card details.</div>
      </div>
    </div>
  </div>
</section>

<script>
document.getElementById('contactSubmitBtn').addEventListener('click', function() {
  const name = document.getElementById('cf-name').value.trim();
  const email = document.getElementById('cf-email').value.trim();
  const subject = document.getElementById('cf-subject').value;
  const msg = document.getElementById('cf-msg').value.trim();
  const msgEl = document.getElementById('contactFormMsg');

  if (!name || !email || !subject || !msg) {
    msgEl.className = 'alert alert-error';
    msgEl.textContent = 'Please fill in all fields before submitting.';
    msgEl.classList.remove('hidden');
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    msgEl.className = 'alert alert-error';
    msgEl.textContent = 'Please enter a valid email address.';
    msgEl.classList.remove('hidden');
    return;
  }

  const mailSubject = encodeURIComponent(`[MockOrbit] ${subject} — from ${name}`);
  const mailBody = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nSubject: ${subject}\n\nMessage:\n${msg}`);
  window.location.href = `mailto:i.mockorbit@gmail.com?subject=${mailSubject}&body=${mailBody}`;

  msgEl.className = 'alert alert-success';
  msgEl.textContent = 'Opening your email client to send the message...';
  msgEl.classList.remove('hidden');
});

// FAQ accordion
document.querySelectorAll('.faq-q').forEach(btn => {
  btn.addEventListener('click', function() {
    const item = this.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
    document.querySelectorAll('.faq-q').forEach(b => b.setAttribute('aria-expanded', 'false'));
    if (!isOpen) {
      item.classList.add('open');
      this.setAttribute('aria-expanded', 'true');
    }
  });
});
</script>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<!-- Exam header — kept for SEO (exam name in h1, schema markup) -->
<section class="ts-exam-hero">
  <div class="container">
    <a href="/" class="ts-back">← All Series</a>
    <div class="ts-exam-meta">
      <div class="ts-exam-icon" aria-hidden="true"><%= exam.icon || '📚' %></div>
      <div>
        <h1 class="ts-exam-title"><%= exam.name %> — Mock Test Series</h1>
        <% if (exam.category) { %>
          <p class="ts-exam-sub"><%= exam.category %> Exam</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error mb-4">⚠️ <%= error[0] %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success mb-4">✓ <%= success[0] %></div>
    <% } %>

    <% if (series.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <h3>No test series available yet</h3>
        <p>We're adding content for <%= exam.name %> soon. Check back shortly!</p>
        <a href="/" class="btn btn-primary" style="margin-top:20px;">Browse Other Exams →</a>
      </div>
    <% } else { %>

      <%
        const isSingle = series.length === 1;
        const isDouble = series.length === 2;
        const gridClass = isSingle ? 'ts-series-single' : isDouble ? 'ts-series-double' : 'ts-series-grid';
      %>
      <div class="<%= gridClass %>">
        <% series.forEach(s => { %>
          <%
            const isPurchased = user && purchasedSeriesForExam &&
              purchasedSeriesForExam.some(ps => ps._id.toString() === s._id.toString());
            const mockLangsCard = s.mockLanguages && s.mockLanguages.length > 0 ? s.mockLanguages : [];
          %>

          <div class="ts-card <%= isPurchased ? 'ts-card-owned' : '' %>">

            <!-- Card header -->
            <div class="ts-card-header">
              <div class="ts-card-header-left">
                <div class="ts-card-badges">
                  <span class="ts-badge ts-badge-blue">
                    📝 <%= s.totalMocks %> Full-Length Mock<%= s.totalMocks > 1 ? 's' : '' %>
                  </span>
                  <% if (s.price === 0) { %>
                    <span class="ts-badge ts-badge-green">Free Access</span>
                  <% } %>
                </div>
                <h2 class="ts-card-title"><%= s.title %></h2>
                <% if (s.description) { %>
                  <p class="ts-card-desc"><%= s.description %></p>
                <% } %>
                <% if (mockLangsCard.length > 0) { %>
                  <div class="ts-mock-langs">
                    <span class="ts-mock-langs-label">Mock available in</span>
                    <% mockLangsCard.forEach(l => { %><span class="ts-mock-lang-pill"><%= l %></span><% }) %>
                  </div>
                <% } %>
              </div>
              <div class="ts-card-header-right">
                <% if (isPurchased) { %>
                  <div class="ts-price-block">
                    <span class="ts-purchased-tag">✓ Purchased</span>
                  </div>
                <% } else { %>
                  <div class="ts-price-block">
                    <% if (s.price === 0) { %>
                      <span class="ts-price-free-label">Free</span>
                    <% } else { %>
                      <span class="ts-price">
                        <span class="ts-price-currency">₹</span><span class="ts-price-amount"><%= s.price.toLocaleString('en-IN') %></span>
                        <span class="ts-price-label">one-time</span>
                      </span>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Features + body -->
            <div class="ts-card-body">
              <div class="ts-card-cols">
                <!-- What's included — from admin input only -->
                <% if (s.features && s.features.length > 0) { %>
                <div class="ts-features">
                  <p class="ts-section-label">What's included</p>
                  <ul class="ts-feature-list">
                    <% s.features.forEach(f => { %>
                      <li><span class="ts-check" aria-hidden="true">✓</span><%= f %></li>
                    <% }) %>
                  </ul>
                </div>
                <% } %>
              </div>

              <!-- Sample Questions -->
              <% if (s.previewQuestions && s.previewQuestions.length > 0) { %>
                <div class="sample-accord" style="margin-top:20px;">
                  <button class="sample-accord-btn" aria-expanded="false">
                    <span>Sample Questions (<%= Math.min(s.previewQuestions.length, 3) %>)</span>
                    <span class="sample-accord-chevron">▼</span>
                  </button>
                  <div class="sample-accord-body" style="display:none">
                    <% s.previewQuestions.slice(0, 3).forEach((pq, idx) => { %>
                      <div class="sample-q-item">
                        <div class="sample-q-text">Q<%= idx + 1 %>. <%= pq.question %></div>
                        <div class="sample-opts">
                          <% ['A','B','C','D'].forEach((letter, i) => { %>
                            <div class="sample-opt <%= i === pq.correctAnswer ? 'is-correct' : '' %>">
                              <span class="sample-opt-lbl"><%= letter %></span>
                              <span><%= pq.options[i] %></span>
                            </div>
                          <% }) %>
                        </div>
                        <% if (pq.explanation) { %>
                          <div class="sample-expl">💡 <%= pq.explanation %></div>
                        <% } %>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Card footer: CTA -->
            <div class="ts-card-footer">
              <% if (isPurchased) { %>
                <a href="/dashboard" class="btn btn-success ts-cta-btn">Go to My Tests →</a>
              <% } else if (s.price === 0) { %>
                <form method="POST" action="/payment/free-access/<%= s._id %>" style="margin:0; flex:1;">
                  <button type="submit" class="btn btn-primary ts-cta-btn">Access Now — Free →</button>
                </form>
              <% } else { %>
                <a href="/payment/checkout/<%= s._id %>" class="btn btn-primary ts-cta-btn">
                  Buy Now — ₹<%= s.price.toLocaleString('en-IN') %> →
                </a>
              <% } %>
              <% if (!user) { %>
                <p class="ts-login-note">
                  <a href="/auth/login">Login</a> to track your progress and rank.
                </p>
              <% } %>
            </div>

          </div>
        <% }) %>
      </div>

    <% } %>
  </div>
</section>

<!-- Student Reviews -->
<% if (seriesReviews && seriesReviews.length > 0) { %>
<section class="section" style="background:var(--canvas-soft); border-top:1px solid var(--border); padding-top:40px; padding-bottom:48px;">
  <div class="container container-sm">
    <div class="section-heading" style="margin-bottom:28px;">
      <span class="section-label">Student Reviews</span>
      <h2 style="font-size:1.4rem;">What Students Are Saying</h2>
    </div>
    <div style="display:flex; flex-direction:column; gap:12px;">
      <% seriesReviews.forEach(r => { %>
        <div class="ts-review-card">
          <div class="ts-review-top">
            <div class="ts-review-avatar"><%= r.name[0].toUpperCase() %></div>
            <div class="ts-review-author">
              <strong><%= r.name %></strong>
              <% if (r.role) { %><span><%= r.role %></span><% } %>
            </div>
            <div class="ts-review-stars"><%= '★'.repeat(r.rating) %></div>
          </div>
          <p class="ts-review-text">"<%= r.text %>"</p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>

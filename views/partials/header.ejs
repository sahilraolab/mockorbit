<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- Primary SEO -->
  <title><%= title %></title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'MockOrbit — Full-length mock tests for Judiciary, CLAT, SSC CGL, Banking & 20+ competitive exams. Real-time rank analytics, AI-powered weak-area reports, and expert solutions.' %>">
  <meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' ? metaKeywords : 'mock test, online mock test, free mock test, judiciary mock test, CLAT mock test, SSC CGL mock test, banking mock test, UPSC mock test, competitive exam preparation, rank predictor, test series India' %>">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="author" content="MockOrbit">
  <link rel="canonical" href="<%= appUrl %><%= currentPath %>">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:url" content="<%= appUrl %><%= currentPath %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Full-length mock tests for top competitive exams. Real rankings, personalised analytics, and expert-crafted questions.' %>">
  <meta property="og:image" content="<%= appUrl %>/images/og-banner.jpg">
  <meta property="og:site_name" content="MockOrbit">
  <meta property="og:locale" content="en_IN">

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@mockorbit">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Full-length mock tests with rank analytics for Judiciary, CLAT, SSC & more.' %>">
  <meta name="twitter:image" content="<%= appUrl %>/images/og-banner.jpg">

  <!-- Theme color -->
  <meta name="theme-color" content="#2563eb">
  <meta name="msapplication-TileColor" content="#2563eb">
  <meta name="msapplication-TileImage" content="/images/icon-192.png">

  <!-- JSON-LD: Organization + WebSite -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%= appUrl %>/#organization",
        "name": "MockOrbit",
        "url": "<%= appUrl %>",
        "logo": {
          "@type": "ImageObject",
          "url": "<%= appUrl %>/images/logo.png",
          "width": 652,
          "height": 383
        },
        "image": {
          "@type": "ImageObject",
          "url": "<%= appUrl %>/images/og-banner.jpg",
          "width": 1200,
          "height": 630
        },
        "description": "MockOrbit — Mission for Academic Rank & Success. India's focused mock test platform for competitive exam aspirants.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "New Delhi",
          "addressCountry": "IN"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "hello@mockorbit.in",
          "availableLanguage": ["English", "Hindi"]
        },
        "sameAs": [
          "https://twitter.com/mockorbit",
          "https://www.instagram.com/mockorbit",
          "https://www.linkedin.com/company/mockorbit",
          "https://www.youtube.com/@mockorbit"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "<%= appUrl %>/#website",
        "url": "<%= appUrl %>",
        "name": "MockOrbit",
        "description": "Mission for Academic Rank & Success",
        "publisher": { "@id": "<%= appUrl %>/#organization" },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "<%= appUrl %>/series/exam/{search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>

  <% if (typeof pageSchema !== 'undefined') { %>
  <script type="application/ld+json"><%- pageSchema %></script>
  <% } %>

  <!-- Google Analytics -->
  <% if (process.env.GA_MEASUREMENT_ID) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GA_MEASUREMENT_ID %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= process.env.GA_MEASUREMENT_ID %>', {
      page_path: '<%= currentPath %>',
      anonymize_ip: true
    });
  </script>
  <% } %>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="application-name" content="MockOrbit">

  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- ADA: Skip to main content -->
<a href="#main-content" class="skip-nav">Skip to main content</a>

<header role="banner">
<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="container">
    <div class="navbar-inner">
      <a href="/" class="navbar-brand" aria-label="MockOrbit — Go to homepage">
        <img src="/images/logo.png" alt="MockOrbit logo" class="navbar-logo-img">
        <span class="brand-text"><span class="brand-mock">Mock</span><span class="brand-orbit">Orbit</span></span>
      </a>

      <!-- Desktop nav -->
      <div class="navbar-nav" role="list" id="desktopNav">
        <a href="/#exams" class="nav-link" role="listitem">Exams</a>
        <a href="/org/login" class="nav-link" role="listitem">For Institutes</a>
        <a href="/about" class="nav-link" role="listitem">About</a>
        <div class="nav-divider" role="separator" aria-hidden="true"></div>
        <% if (user) { %>
          <a href="/dashboard" class="nav-link" role="listitem">My Dashboard</a>
          <a href="/auth/logout" class="nav-link" role="listitem">Logout</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-primary btn-sm" role="listitem">Login Free</a>
        <% } %>
      </div>

      <!-- Mobile hamburger -->
      <button class="hamburger" id="hamburgerBtn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileMenu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile slide-in menu -->
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Navigation menu" aria-hidden="true">
  <div class="mobile-menu-inner">
    <div class="mobile-menu-header">
      <div style="display:flex;align-items:center;gap:8px;">
        <img src="/images/logo.png" alt="MockOrbit" style="height:28px;width:auto;object-fit:contain;">
        <span class="brand-text"><span class="brand-mock">Mock</span><span class="brand-orbit">Orbit</span></span>
      </div>
      <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close navigation menu">✕</button>
    </div>
    <nav class="mobile-nav">
      <a href="/#exams" class="mobile-nav-link">📚 Exams</a>
      <a href="/org/login" class="mobile-nav-link">🏛️ For Institutes</a>
      <a href="/about" class="mobile-nav-link">ℹ️ About</a>
      <a href="/contact" class="mobile-nav-link">✉️ Contact</a>
      <div class="mobile-nav-divider"></div>
      <% if (user) { %>
        <a href="/dashboard" class="mobile-nav-link mobile-nav-primary">📊 My Dashboard</a>
        <a href="/auth/logout" class="mobile-nav-link">← Logout</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-primary btn-block" style="margin-top:8px;">Login Free →</a>
      <% } %>
    </nav>
  </div>
</div>
<div class="mobile-overlay" id="mobileOverlay"></div>
</header>

<% if (isAdminImpersonating) { %>
<div class="impersonate-banner">
  <span>⚠️ Admin view — you are impersonating a user/org</span>
  <a href="/admin/stop-impersonation" class="btn btn-sm" style="background:#f59e0b;color:white;padding:6px 14px;">Return to Admin →</a>
</div>
<% } %>
<main id="main-content" role="main">

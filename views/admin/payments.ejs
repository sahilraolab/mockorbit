<%- include('layout-top', { title: title, currentPath: '/admin/payments' }) %>

<div class="admin-page-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
  <h3 style="font-family: 'DM Sans';">Payments & Invoices</h3>
  <div style="display:flex; gap:16px; align-items:center;">
    <div style="background:var(--success-light); color:var(--success); border-radius:var(--radius); padding:8px 16px; font-size:0.9rem; font-weight:700;">
      ₹<%= totalRevenue.toLocaleString('en-IN') %> Total Revenue
    </div>
    <div style="font-size:0.85rem; color:var(--ink-muted);"><%= payments.filter(p=>p.status==='success').length %> successful payments</div>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Student</th>
        <th>Test Series</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Order ID</th>
        <th>Payment ID</th>
        <th>Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (payments.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted" style="padding:32px;">No payments yet.</td></tr>
      <% } %>
      <% payments.forEach(p => { %>
        <tr>
          <td style="font-size:0.85rem;">
            <div style="font-weight:500;"><%= p.userId ? p.userId.email : '—' %></div>
          </td>
          <td style="font-size:0.85rem;"><%= p.testSeriesId ? p.testSeriesId.title : 'Deleted' %></td>
          <td style="font-weight:700; color:var(--ink);">₹<%= (p.amount || 0).toLocaleString('en-IN') %></td>
          <td>
            <span class="badge <%= p.status === 'success' ? 'badge-green' : p.status === 'failed' ? '' : 'badge-warm' %>"
              style="<%= p.status === 'failed' ? 'background:var(--danger-light);color:var(--danger);' : '' %>">
              <%= p.status %>
            </span>
          </td>
          <td><code style="font-size:0.75rem; color:var(--ink-muted);"><%= p.razorpayOrderId || '—' %></code></td>
          <td><code style="font-size:0.75rem; color:var(--ink-muted);"><%= p.razorpayPaymentId || '—' %></code></td>
          <td style="font-size:0.8rem; color:var(--ink-muted);"><%= new Date(p.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></td>
          <td><a href="/admin/payments/<%= p._id %>/pdf" target="_blank" class="btn btn-outline btn-sm">PDF</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('layout-bottom') %>

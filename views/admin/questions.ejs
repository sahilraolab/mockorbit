<%- include('layout-top', { title: title, currentPath: '/admin/questions' }) %>

<% if (error && error.length > 0) { %><div class="alert alert-error mb-4">⚠️ <%= error[0] %></div><% } %>
<% if (success && success.length > 0) { %><div class="alert alert-success mb-4">✓ <%= success[0] %></div><% } %>

<!-- Test selector -->
<div class="card mb-6">
  <form method="GET" action="/admin/questions" id="testSelectForm">
    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label">Select Test to Manage Questions</label>
      <select name="testId" class="form-control" onchange="this.form.submit()" style="max-width:480px;">
        <option value="">— Choose a test —</option>
        <% tests.forEach(t => { %>
          <option value="<%= t._id %>" <%= testId && testId.toString() === t._id.toString() ? 'selected' : '' %>><%= t.title %></option>
        <% }) %>
      </select>
      <span class="form-hint" style="margin-top:6px;display:block;">Questions load automatically when you select a test.</span>
    </div>
  </form>
</div>

<% if (selectedTest) { %>
  <div class="admin-page-header">
    <div>
      <h3 style="font-family: 'DM Sans';"><%= selectedTest.title %></h3>
      <p class="text-small text-muted"><%= questions.length %> questions · <%= selectedTest.duration %> minutes</p>
    </div>
    <div style="display:flex; gap:10px;">
      <button class="btn btn-outline btn-sm" onclick="openModal('bulkQModal')">⬆ Bulk Import</button>
      <button class="btn btn-primary" onclick="openModal('addQModal')">+ Add Question</button>
    </div>
  </div>

  <% if (questions.length === 0) { %>
    <div class="empty-state card">
      <div class="empty-state-icon">❓</div>
      <h3>No questions yet</h3>
      <p>Add your first question to this test.</p>
      <button class="btn btn-primary mt-4" onclick="openModal('addQModal')">+ Add Question</button>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <% questions.forEach((q, idx) => { %>
        <div class="card" style="padding: 20px 24px;">
          <div class="flex-between mb-3">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="badge badge-blue">Q<%= idx + 1 %></span>
              <span class="badge badge-warm"><%= q.tag %></span>
            </div>
            <div style="display:flex;gap:8px;">
              <button class="btn btn-outline btn-sm" type="button"
                onclick="openEditQModal('<%= q._id %>',`<%= q.question.replace(/`/g,'\\`').replace(/'/g,`\\'`) %>`,`<%= q.options[0].replace(/`/g,'\\`') %>`,`<%= q.options[1].replace(/`/g,'\\`') %>`,`<%= q.options[2].replace(/`/g,'\\`') %>`,`<%= q.options[3].replace(/`/g,'\\`') %>`,<%= q.correctAnswer %>,`<%= (q.explanation||'').replace(/`/g,'\\`') %>`,`<%= (q.tag||'').replace(/`/g,'\\`') %>`)">Edit</button>
              <form method="POST" action="/admin/questions/<%= q._id %>/delete?testId=<%= testId %>" onsubmit="return confirm('Delete this question?')" style="margin:0;">
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
              </form>
            </div>
          </div>
          <p class="fw-600 text-small mb-3" style="color: var(--ink);"><%= q.question %></p>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <% q.options.forEach((opt, i) => { %>
              <div style="padding: 8px 12px; border-radius: 8px; font-size: 0.83rem; border: 1.5px solid <%= i === q.correctAnswer ? 'var(--success)' : 'var(--border)' %>; background: <%= i === q.correctAnswer ? 'var(--success-light)' : 'var(--canvas-soft)' %>; color: <%= i === q.correctAnswer ? 'var(--success)' : 'var(--ink-soft)' %>;">
                <strong><%= ['A','B','C','D'][i] %>.</strong> <%= opt %>
                <% if (i === q.correctAnswer) { %> ✓<% } %>
              </div>
            <% }) %>
          </div>
          <% if (q.explanation) { %>
            <div class="explanation-box mt-3">
              <span class="text-xs text-muted fw-600">EXPLANATION</span>
              <p class="text-small mt-1"><%= q.explanation %></p>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Add Question Modal -->
  <div class="modal-backdrop" id="addQModal">
    <div class="modal" style="max-width: 640px;">
      <div class="modal-header">
        <h4 style="font-family: 'DM Sans';">Add Question</h4>
        <button class="modal-close" onclick="closeModal('addQModal')">✕</button>
      </div>
      <form method="POST" action="/admin/questions">
        <input type="hidden" name="testId" value="<%= testId %>">

        <div class="form-group">
          <label class="form-label">Question Text *</label>
          <textarea name="question" class="form-control" rows="3" placeholder="Enter the question..." required></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label class="form-label">Option A *</label>
            <input type="text" name="option0" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">Option B *</label>
            <input type="text" name="option1" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">Option C *</label>
            <input type="text" name="option2" class="form-control" required>
          </div>
          <div class="form-group">
            <label class="form-label">Option D *</label>
            <input type="text" name="option3" class="form-control" required>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label class="form-label">Correct Answer *</label>
            <select name="correctAnswer" class="form-control" required>
              <option value="0">A</option>
              <option value="1">B</option>
              <option value="2">C</option>
              <option value="3">D</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Tag (Topic) *</label>
            <input type="text" name="tag" class="form-control" placeholder="e.g., Constitutional Law" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Explanation</label>
          <textarea name="explanation" class="form-control" rows="2" placeholder="Explain the correct answer..."></textarea>
        </div>

        <div style="display: flex; gap: 10px; justify-content: flex-end;">
          <button type="button" class="btn btn-outline" onclick="closeModal('addQModal')">Cancel</button>
          <button type="submit" class="btn btn-primary">Add Question</button>
        </div>
      </form>
    </div>
  </div>

<% } else { %>
  <div class="empty-state">
    <div class="empty-state-icon">❓</div>
    <h3>Select a test above</h3>
    <p>Choose a test from the dropdown to view and manage its questions.</p>
  </div>
<% } %>

<!-- Bulk Import Questions Modal -->
<div class="modal-backdrop" id="bulkQModal">
  <div class="modal" style="max-width:540px;">
    <div class="modal-header">
      <h4 style="font-family:'DM Sans';">Bulk Import Questions</h4>
      <button class="modal-close" onclick="closeModal('bulkQModal')">✕</button>
    </div>
    <div style="padding:20px 24px;">

      <!-- Tabs -->
      <div style="display:flex; gap:0; border-bottom:2px solid var(--border); margin-bottom:20px;">
        <button id="tabExcel" onclick="switchImportTab('excel')" style="padding:8px 18px; font-size:0.85rem; font-weight:600; border:none; background:none; cursor:pointer; border-bottom:2px solid var(--primary); margin-bottom:-2px; color:var(--primary);">📊 Excel (.xlsx)</button>
        <button id="tabCsv" onclick="switchImportTab('csv')" style="padding:8px 18px; font-size:0.85rem; font-weight:600; border:none; background:none; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-2px; color:var(--ink-muted);">📄 CSV</button>
      </div>

      <!-- Excel Panel -->
      <div id="panelExcel">
        <div class="alert" style="background:var(--canvas-soft); border:1px solid var(--border); border-radius:var(--radius); padding:12px 16px; margin-bottom:16px;">
          <p style="font-size:0.82rem; font-weight:600; color:var(--ink); margin-bottom:6px;">Required Excel columns (row 1 = headers)</p>
          <code style="font-size:0.72rem; color:var(--ink-soft); display:block; background:var(--canvas); padding:8px 10px; border-radius:6px; border:1px solid var(--border); word-break:break-all;">question | optionA | optionB | optionC | optionD | correctAnswer | explanation | tag</code>
          <p style="font-size:0.73rem; color:var(--ink-muted); margin-top:6px;"><strong>correctAnswer</strong>: A / B / C / D (or 0 / 1 / 2 / 3)</p>
        </div>
        <a id="excelTemplateLink" href="#" download="questions_template.xlsx" onclick="downloadExcelTemplate(event)"
           class="btn btn-outline btn-sm btn-block" style="margin-bottom:16px;">
          ⬇ Download Excel Template
        </a>
        <form action="/admin/questions/excel-import" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="testId" value="<%= testId || '' %>">
          <div class="form-group">
            <label class="form-label" for="qExcelFile">Select Excel File (.xlsx) <span style="color:var(--danger)">*</span></label>
            <input type="file" id="qExcelFile" name="excelFile" class="form-control" accept=".xlsx,.xls" required>
          </div>
          <div style="display:flex; gap:12px; margin-top:8px;">
            <button type="submit" class="btn btn-primary" style="flex:1;" <%= !testId ? 'disabled title="Select a test first"' : '' %>>
              Import from Excel
            </button>
            <button type="button" class="btn btn-outline" onclick="closeModal('bulkQModal')">Cancel</button>
          </div>
          <% if (!testId) { %><p style="font-size:0.76rem; color:var(--warning); margin-top:8px;">⚠ Select a test from the dropdown first.</p><% } %>
        </form>
      </div>

      <!-- CSV Panel -->
      <div id="panelCsv" style="display:none;">
        <div class="alert" style="background:var(--canvas-soft); border:1px solid var(--border); border-radius:var(--radius); padding:12px 16px; margin-bottom:16px;">
          <p style="font-size:0.82rem; font-weight:600; color:var(--ink); margin-bottom:6px;">Required CSV columns</p>
          <code style="font-size:0.72rem; color:var(--ink-soft); display:block; background:var(--canvas); padding:8px 10px; border-radius:6px; border:1px solid var(--border); word-break:break-all;">question,optionA,optionB,optionC,optionD,correctAnswer,explanation,tag</code>
          <p style="font-size:0.73rem; color:var(--ink-muted); margin-top:6px;"><strong>correctAnswer</strong>: A / B / C / D (or 0 / 1 / 2 / 3)</p>
        </div>
        <a href="data:text/csv;charset=utf-8,question%2CoptionA%2CoptionB%2CoptionC%2CoptionD%2CcorrectAnswer%2Cexplanation%2Ctag%0ASample+question%3F%2COption+1%2COption+2%2COption+3%2COption+4%2CA%2CBecause...%2CGeneral"
           download="questions_template.csv"
           class="btn btn-outline btn-sm btn-block" style="margin-bottom:16px;">
          ⬇ Download CSV Template
        </a>
        <form action="/admin/questions/bulk-import" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="testId" value="<%= testId || '' %>">
          <div class="form-group">
            <label class="form-label" for="qCsvFile">Select CSV File <span style="color:var(--danger)">*</span></label>
            <input type="file" id="qCsvFile" name="csvFile" class="form-control" accept=".csv,text/csv" required>
          </div>
          <div style="display:flex; gap:12px; margin-top:8px;">
            <button type="submit" class="btn btn-primary" style="flex:1;" <%= !testId ? 'disabled title="Select a test first"' : '' %>>
              Import from CSV
            </button>
            <button type="button" class="btn btn-outline" onclick="closeModal('bulkQModal')">Cancel</button>
          </div>
          <% if (!testId) { %><p style="font-size:0.76rem; color:var(--warning); margin-top:8px;">⚠ Select a test from the dropdown first.</p><% } %>
        </form>
      </div>

    </div>
  </div>
</div>

<!-- Edit Question Modal -->
<div class="modal-backdrop" id="editQModal">
  <div class="modal" style="max-width: 640px;">
    <div class="modal-header">
      <h4 style="font-family: 'DM Sans';">Edit Question</h4>
      <button class="modal-close" onclick="closeModal('editQModal')">✕</button>
    </div>
    <form method="POST" id="editQForm" action="">
      <input type="hidden" name="_redirect" value="<%= testId ? '/admin/questions?testId=' + testId : '/admin/questions' %>">
      <div class="form-group">
        <label class="form-label">Question Text *</label>
        <textarea name="question" id="eq_question" class="form-control" rows="3" required></textarea>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label class="form-label">Option A *</label>
          <input type="text" name="option0" id="eq_opt0" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label">Option B *</label>
          <input type="text" name="option1" id="eq_opt1" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label">Option C *</label>
          <input type="text" name="option2" id="eq_opt2" class="form-control" required>
        </div>
        <div class="form-group">
          <label class="form-label">Option D *</label>
          <input type="text" name="option3" id="eq_opt3" class="form-control" required>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div class="form-group">
          <label class="form-label">Correct Answer *</label>
          <select name="correctAnswer" id="eq_ans" class="form-control" required>
            <option value="0">A</option>
            <option value="1">B</option>
            <option value="2">C</option>
            <option value="3">D</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Tag (Topic) *</label>
          <input type="text" name="tag" id="eq_tag" class="form-control" required>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Explanation</label>
        <textarea name="explanation" id="eq_exp" class="form-control" rows="2"></textarea>
      </div>
      <div style="display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" class="btn btn-outline" onclick="closeModal('editQModal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditQModal(id, question, opt0, opt1, opt2, opt3, ans, explanation, tag) {
  document.getElementById('editQForm').action = '/admin/questions/' + id + '/update';
  document.getElementById('eq_question').value = question;
  document.getElementById('eq_opt0').value     = opt0;
  document.getElementById('eq_opt1').value     = opt1;
  document.getElementById('eq_opt2').value     = opt2;
  document.getElementById('eq_opt3').value     = opt3;
  document.getElementById('eq_ans').value      = ans;
  document.getElementById('eq_exp').value      = explanation;
  document.getElementById('eq_tag').value      = tag;
  openModal('editQModal');
}
</script>

<script>
function switchImportTab(tab) {
  document.getElementById('panelExcel').style.display = tab === 'excel' ? '' : 'none';
  document.getElementById('panelCsv').style.display   = tab === 'csv'   ? '' : 'none';
  document.getElementById('tabExcel').style.borderBottomColor = tab === 'excel' ? 'var(--primary)' : 'transparent';
  document.getElementById('tabExcel').style.color = tab === 'excel' ? 'var(--primary)' : 'var(--ink-muted)';
  document.getElementById('tabCsv').style.borderBottomColor = tab === 'csv' ? 'var(--primary)' : 'transparent';
  document.getElementById('tabCsv').style.color = tab === 'csv' ? 'var(--primary)' : 'var(--ink-muted)';
}

function downloadExcelTemplate(e) {
  e.preventDefault();
  // Build a minimal xlsx using SheetJS CDN (loaded below) or fall back to CSV
  if (typeof XLSX !== 'undefined') {
    const ws = XLSX.utils.aoa_to_sheet([
      ['question','optionA','optionB','optionC','optionD','correctAnswer','explanation','tag'],
      ['Sample question text?','Option 1','Option 2','Option 3','Option 4','A','Because option A is correct.','Constitutional Law'],
    ]);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Questions');
    XLSX.writeFile(wb, 'questions_template.xlsx');
  } else {
    // Fallback: download CSV
    const a = document.createElement('a');
    a.href = 'data:text/csv;charset=utf-8,question%2CoptionA%2CoptionB%2CoptionC%2CoptionD%2CcorrectAnswer%2Cexplanation%2Ctag%0ASample+question%3F%2COption+1%2COption+2%2COption+3%2COption+4%2CA%2CBecause...%2CConstitutional+Law';
    a.download = 'questions_template.csv';
    a.click();
  }
}
</script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>

<%- include('layout-bottom') %>

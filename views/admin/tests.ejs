<%- include('layout-top', { title: title, currentPath: '/admin/tests' }) %>

<% if (error && error.length > 0) { %><div class="alert alert-error mb-4">⚠️ <%= error[0] %></div><% } %>
<% if (success && success.length > 0) { %><div class="alert alert-success mb-4">✓ <%= success[0] %></div><% } %>

<div class="admin-page-header">
  <h3 style="font-family: 'DM Sans';">Tests (<%= tests.length %>)</h3>
  <button class="btn btn-primary" onclick="openModal('addTestModal')">+ Add Test</button>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Series</th>
        <th>Duration</th>
        <th>Questions</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (tests.length === 0) { %>
        <tr><td colspan="5" class="text-center text-muted" style="padding: 32px;">No tests yet. Add your first test.</td></tr>
      <% } %>
      <% tests.forEach(t => { %>
        <tr>
          <td class="fw-600"><%= t.title %></td>
          <td><%= t.testSeriesId ? t.testSeriesId.title : '—' %></td>
          <td><%= t.duration %> min</td>
          <td>
            <a href="/admin/questions?testId=<%= t._id %>" class="badge badge-blue"><%= t.totalQuestions %> Qs</a>
          </td>
          <td>
            <div style="display: flex; gap: 8px;">
              <a href="/admin/questions?testId=<%= t._id %>" class="btn btn-outline btn-sm">Questions</a>
              <form method="POST" action="/admin/tests/<%= t._id %>/delete" onsubmit="return confirm('Delete this test and all its questions?')">
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Add Test Modal -->
<div class="modal-backdrop" id="addTestModal">
  <div class="modal">
    <div class="modal-header">
      <h4 style="font-family: 'DM Sans';">Add Test</h4>
      <button class="modal-close" onclick="closeModal('addTestModal')">✕</button>
    </div>
    <form method="POST" action="/admin/tests">
      <div class="form-group">
        <label class="form-label">Test Series *</label>
        <select name="testSeriesId" class="form-control" required>
          <option value="">Select Test Series</option>
          <% series.forEach(s => { %>
            <option value="<%= s._id %>"><%= s.title %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Test Title *</label>
        <input type="text" name="title" class="form-control" placeholder="e.g., Mock Test 1" required>
      </div>
      <div class="form-group">
        <label class="form-label">Duration (minutes) *</label>
        <input type="number" name="duration" class="form-control" placeholder="120" min="1" required>
      </div>
      <div style="display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" class="btn btn-outline" onclick="closeModal('addTestModal')">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Test</button>
      </div>
    </form>
  </div>
</div>

<%- include('layout-bottom') %>

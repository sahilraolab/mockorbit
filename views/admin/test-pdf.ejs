<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= test.title %> — MockOrbit</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; color: #1c2b3a; background: #fff; padding: 32px 40px; }
    .print-btn { position: fixed; top: 16px; right: 16px; background: #2563eb; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; }
    @media print { .print-btn { display: none; } }

    .header { border-bottom: 2px solid #1e3a8a; padding-bottom: 16px; margin-bottom: 24px; }
    .brand { font-size: 1.4rem; font-weight: 800; color: #1e3a8a; letter-spacing: -0.02em; }
    .brand span { color: #2563eb; }
    .test-title { font-size: 1.2rem; font-weight: 700; margin: 8px 0 4px; color: #0f172a; }
    .test-meta { font-size: 0.78rem; color: #6b7280; display: flex; gap: 16px; flex-wrap: wrap; }
    .test-meta span { display: flex; align-items: center; gap: 4px; }

    .q-block { margin-bottom: 22px; border: 1px solid #e2e8ef; border-radius: 8px; padding: 14px 16px; page-break-inside: avoid; }
    .q-header { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 8px; }
    .q-num { background: #2563eb; color: #fff; font-size: 0.7rem; font-weight: 800; padding: 2px 8px; border-radius: 99px; flex-shrink: 0; margin-top: 2px; }
    .q-tag { background: #eff6ff; color: #2563eb; font-size: 0.65rem; font-weight: 600; padding: 2px 8px; border-radius: 99px; flex-shrink: 0; margin-top: 2px; }
    .q-text { font-size: 0.88rem; font-weight: 500; line-height: 1.55; color: #0f172a; }
    .options { margin-top: 10px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .option { display: flex; align-items: flex-start; gap: 8px; font-size: 0.82rem; color: #374151; line-height: 1.45; }
    .opt-letter { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid #d1d5db; font-size: 0.68rem; font-weight: 700; color: #6b7280; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .opt-letter.correct { background: #d1fae5; border-color: #059669; color: #059669; }
    .explanation { margin-top: 10px; padding: 8px 12px; background: #f0fdf4; border-left: 3px solid #059669; border-radius: 4px; font-size: 0.78rem; color: #065f46; line-height: 1.5; }

    .footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #e2e8ef; font-size: 0.72rem; color: #9ca3af; text-align: center; }
  </style>
</head>
<body>

<button class="print-btn" onclick="window.print()">⬇ Save as PDF</button>

<div class="header">
  <div class="brand">Mock<span>Orbit</span></div>
  <div class="test-title"><%= test.title %></div>
  <div class="test-meta">
    <% if (test.testSeriesId) { %><span>📚 <%= test.testSeriesId.title %></span><% } %>
    <span>⏱ <%= test.duration %> min</span>
    <span>❓ <%= questions.length %> Questions</span>
    <span>📅 <%= new Date().toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' }) %></span>
  </div>
</div>

<% questions.forEach((q, i) => { %>
<div class="q-block">
  <div class="q-header">
    <span class="q-num">Q<%= i + 1 %></span>
    <% if (q.tag) { %><span class="q-tag"><%= q.tag %></span><% } %>
    <span class="q-text"><%= q.question %></span>
  </div>
  <div class="options">
    <% q.options.forEach((opt, oi) => { %>
    <div class="option">
      <span class="opt-letter <%= q.correctAnswer === oi ? 'correct' : '' %>"><%= ['A','B','C','D'][oi] %></span>
      <span><%= opt %></span>
    </div>
    <% }) %>
  </div>
  <% if (q.explanation) { %>
  <div class="explanation"><strong>Explanation:</strong> <%= q.explanation %></div>
  <% } %>
</div>
<% }) %>

<div class="footer">
  MockOrbit — Mission for Academic Rank &amp; Success &nbsp;·&nbsp; <%= process.env.APP_URL || 'https://mockorbit.com' %>
  &nbsp;·&nbsp; Generated <%= new Date().toLocaleDateString('en-IN', { day:'2-digit', month:'long', year:'numeric' }) %>
</div>

</body>
</html>

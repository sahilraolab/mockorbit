<%- include('layout-top', { title: title, currentPath: '/admin/settings' }) %>

<% if (error && error.length > 0) { %><div class="alert alert-error mb-4">⚠️ <%= error[0] %></div><% } %>
<% if (success && success.length > 0) { %><div class="alert alert-success mb-4">✓ <%= success[0] %></div><% } %>

<div class="admin-page-header">
  <h3 style="font-family:'DM Sans';">Site Settings</h3>
</div>

<form method="POST" action="/admin/settings">
  <div class="card" style="padding:24px 28px; max-width:720px;">

    <div class="sf-section-header" style="margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid var(--border);">
      <span style="font-size:1.1rem;">🏠</span>
      <span style="font-size:0.95rem; font-weight:700; font-family:'DM Sans',sans-serif;">Homepage Hero Text</span>
    </div>

    <div class="form-group">
      <label class="form-label">Hero Heading</label>
      <input type="text" name="hero_heading" class="form-control"
        value="<%= settings.hero_heading || 'Mission for Academic Rank & Success' %>"
        placeholder="Mission for Academic Rank & Success">
      <span class="sf-hint">The main H1 on the homepage. Keep it short and punchy (5–7 words).</span>
    </div>

    <div class="form-group">
      <label class="form-label">Hero Subheading</label>
      <textarea name="hero_sub" class="form-control" rows="3"
        placeholder="Full-length mock tests for top competitive exams…"><%= settings.hero_sub || '' %></textarea>
      <span class="sf-hint">The descriptive paragraph below the heading. 1–2 sentences recommended.</span>
    </div>

    <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:8px;">
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </div>
  </div>
</form>

<style>
.sf-hint { font-size:0.72rem; color:var(--ink-muted); margin-left:4px; display:block; margin-top:4px; }
.sf-section-header { display:flex; align-items:center; gap:10px; }
</style>

<%- include('layout-bottom') %>

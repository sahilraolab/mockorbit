<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDesc %>">
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
</head>
<body>
<a href="#main-content" class="skip-nav">Skip to main content</a>

<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="container">
    <div class="navbar-inner">
      <a href="/" class="navbar-brand" aria-label="MockOrbit home">
        <span class="brand-mock">Mock</span><span class="brand-orbit">Orbit</span>
      </a>
      <div class="navbar-nav">
        <a href="/org/register" class="nav-link">Register Institution</a>
        <a href="/auth/login" class="btn btn-outline btn-sm">Student Login</a>
      </div>
    </div>
  </div>
</nav>

<main id="main-content" class="auth-page" role="main">
  <div class="auth-card">
    <div class="auth-brand">
      <div><span class="auth-brand brand-mock">Mock</span><span class="auth-brand brand-orbit">Orbit</span></div>
      <p class="auth-tagline">Institution Dashboard</p>
    </div>
    <h1 style="font-size:1.4rem; text-align:center; margin-bottom:6px;">Welcome Back</h1>
    <p style="text-align:center; font-size:0.88rem; color:var(--ink-muted); margin-bottom:28px;">Login to manage students, assignments &amp; results.</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error" role="alert">⚠️ <%= error[0] %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success" role="status">✓ <%= success[0] %></div>
    <% } %>

    <form action="/org/login" method="POST" novalidate aria-label="Institution login form">
      <div class="form-group">
        <label class="form-label" for="email">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="your@institution.in" required autocomplete="email" aria-required="true">
      </div>
      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Your password" required autocomplete="current-password" aria-required="true">
      </div>
      <button type="submit" class="btn btn-primary btn-block" style="margin-top:4px;">Login to Dashboard</button>
    </form>

    <div class="auth-divider"><span>New to MockOrbit?</span></div>
    <a href="/org/register" class="btn btn-outline btn-block">Register Your Institution</a>
  </div>
</main>

<footer style="text-align:center;padding:20px;font-size:0.78rem;color:var(--ink-muted);border-top:1px solid var(--border);">
  © <%= new Date().getFullYear() %> MockOrbit — <a href="/">Return to Home</a>
</footer>
<script src="/js/app.js"></script>
</body>
</html>

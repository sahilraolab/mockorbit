<%- include('layout-top') %>

<% if (error && error.length > 0) { %>
  <div class="alert alert-error" role="alert">⚠️ <%= error[0] %></div>
<% } %>
<% if (success && success.length > 0) { %>
  <div class="alert alert-success" role="status">✓ <%= success[0] %></div>
<% } %>

<div class="org-page-header">
  <div>
    <h1 style="font-size:1.5rem; margin-bottom:4px;">Assignments</h1>
    <p style="font-size:0.88rem; color:var(--ink-muted);"><%= assignments.length %> total assignments</p>
  </div>
  <button class="btn btn-primary" onclick="document.getElementById('create-modal').classList.add('open')" aria-haspopup="dialog">+ Create Assignment</button>
</div>

<% if (assignments.length === 0) { %>
  <div class="empty-state">
    <div class="empty-state-icon" aria-hidden="true">📋</div>
    <h3>No assignments yet</h3>
    <p>Assign a test to your students so they can take it on MockOrbit.</p>
    <button class="btn btn-primary" style="margin-top:16px;" onclick="document.getElementById('create-modal').classList.add('open')">Create First Assignment</button>
  </div>
<% } else { %>
  <div style="display:flex; flex-direction:column; gap:12px;" role="list" aria-label="Assignments list">
    <% assignments.forEach(a => { %>
      <div class="assignment-card" role="listitem">
        <div style="flex:1;">
          <div style="font-weight:600; font-size:0.97rem; color:var(--ink); margin-bottom:4px;"><%= a.title %></div>
          <div class="assignment-meta">
            <% if (a.testId) { %>
              📝 <%= a.testId.title %>
              <% if (a.testId.duration) { %> &nbsp;·&nbsp; ⏱️ <%= a.testId.duration %> min<% } %>
              <% if (a.testId.totalQuestions) { %> &nbsp;·&nbsp; <%= a.testId.totalQuestions %> Qs<% } %>
            <% } else { %>
              Test deleted
            <% } %>
            &nbsp;·&nbsp;
            <%= a.assignAll ? '👥 All students' : ('👤 ' + a.assignedStudents.length + ' students') %>
            <% if (a.dueDate) { %>
              &nbsp;·&nbsp; 📅 Due: <strong><%= new Date(a.dueDate).toLocaleDateString('en-IN') %></strong>
            <% } %>
          </div>
          <% if (a.instructions) { %>
            <p style="font-size:0.82rem; color:var(--ink-muted); margin-top:6px; font-style:italic;">"<%= a.instructions %>"</p>
          <% } %>
        </div>
        <div style="display:flex; align-items:center; gap:10px; flex-shrink:0;">
          <a href="/org/results?assignment=<%= a._id %>" class="btn btn-ghost btn-sm" aria-label="View results for <%= a.title %>">View Results</a>
          <form action="/org/assignments/<%= a._id %>/delete" method="POST" onsubmit="return confirm('Delete this assignment?')">
            <button type="submit" class="btn btn-danger btn-sm" aria-label="Delete assignment <%= a.title %>">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<!-- Create assignment modal -->
<div class="modal-backdrop" id="create-modal" role="dialog" aria-modal="true" aria-labelledby="create-modal-title">
  <div class="modal" style="max-width:560px;">
    <div class="modal-header">
      <h2 id="create-modal-title" style="font-size:1.1rem; font-family:'DM Sans',sans-serif;">Create Assignment</h2>
      <button class="modal-close" onclick="document.getElementById('create-modal').classList.remove('open')" aria-label="Close create assignment dialog">✕</button>
    </div>
    <form action="/org/assignments" method="POST" novalidate aria-label="Create assignment form">
      <div class="form-group">
        <label class="form-label" for="a-title">Assignment Title <span aria-hidden="true" style="color:var(--danger)">*</span></label>
        <input type="text" id="a-title" name="title" class="form-control" placeholder="e.g. Weekly Mock — Week 3" required aria-required="true">
      </div>
      <div class="form-group">
        <label class="form-label" for="a-test">Select Test <span aria-hidden="true" style="color:var(--danger)">*</span></label>
        <select id="a-test" name="testId" class="form-control" required aria-required="true">
          <option value="">— Choose a test —</option>
          <% tests.forEach(t => { %>
            <option value="<%= t._id %>">
              <%= t.testSeriesId ? t.testSeriesId.title + ' · ' : '' %><%= t.title %>
              (<%= t.duration %> min, <%= t.totalQuestions %> Qs)
            </option>
          <% }) %>
        </select>
        <% if (tests.length === 0) { %>
          <p class="form-hint" style="color:var(--warning);">No tests available. Ask admin to add tests first.</p>
        <% } %>
      </div>
      <div class="form-group">
        <label class="form-label" for="a-instructions">Instructions (optional)</label>
        <textarea id="a-instructions" name="instructions" class="form-control" placeholder="Any specific instructions for students..." rows="2"></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="a-due">Due Date (optional)</label>
        <input type="date" id="a-due" name="dueDate" class="form-control" min="<%= new Date().toISOString().split('T')[0] %>">
      </div>
      <div class="form-group">
        <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
          <input type="checkbox" name="assignAll" value="on" checked style="width:16px; height:16px; accent-color:var(--accent);" aria-label="Assign to all active students">
          <span style="font-size:0.9rem; color:var(--ink);">Assign to all active students</span>
        </label>
        <p class="form-hint">When checked, all current and future active students in your organisation can take this test.</p>
      </div>
      <div style="display:flex; gap:12px; margin-top:8px;">
        <button type="submit" class="btn btn-primary" style="flex:1;">Create Assignment</button>
        <button type="button" class="btn btn-outline" onclick="document.getElementById('create-modal').classList.remove('open')">Cancel</button>
      </div>
    </form>
  </div>
</div>

<%- include('layout-bottom') %>

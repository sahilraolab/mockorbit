<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card" style="max-width:500px;">
    <div class="auth-brand">
      <div><span class="auth-brand brand-mock">Mock</span><span class="auth-brand brand-orbit">Orbit</span></div>
      <p class="auth-tagline">Mission for Academic Rank &amp; Success</p>
    </div>
    <h1 style="font-size:1.4rem; text-align:center; margin-bottom:6px;">Register Your Institution</h1>
    <p style="text-align:center; font-size:0.88rem; color:var(--ink-muted); margin-bottom:28px;">Join institutes already using MockOrbit to track student performance.</p>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error" role="alert">⚠️ <%= error[0] %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success" role="status">✓ <%= success[0] %></div>
    <% } %>

    <form action="/org/register" method="POST" novalidate aria-label="Institution registration form">
      <div class="form-group">
        <label class="form-label" for="name">Institution Name <span aria-hidden="true" style="color:var(--danger)">*</span></label>
        <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Krishna Law Academy" required autocomplete="organization" aria-required="true">
      </div>
      <div class="form-group">
        <label class="form-label" for="email">Official Email <span aria-hidden="true" style="color:var(--danger)">*</span></label>
        <input type="email" id="email" name="email" class="form-control" placeholder="principal@yourinstitution.in" required autocomplete="email" aria-required="true">
      </div>
      <div class="form-group">
        <label class="form-label" for="phone">Phone Number</label>
        <input type="tel" id="phone" name="phone" class="form-control" placeholder="9876543210" autocomplete="tel">
      </div>
      <div class="form-group">
        <label class="form-label" for="orgType">Institution Type</label>
        <select id="orgType" name="orgType" class="form-control">
          <option value="coaching">Coaching Centre</option>
          <option value="school">School</option>
          <option value="college">College</option>
          <option value="law_academy">Law Academy</option>
          <option value="university">University</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="address">Address / City</label>
        <input type="text" id="address" name="address" class="form-control" placeholder="e.g. Lucknow, Uttar Pradesh" autocomplete="street-address">
      </div>
      <div class="form-group">
        <label class="form-label" for="password">Password <span aria-hidden="true" style="color:var(--danger)">*</span></label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Minimum 8 characters" required minlength="8" autocomplete="new-password" aria-required="true">
      </div>
      <div class="form-group">
        <label class="form-label" for="confirmPassword">Confirm Password <span aria-hidden="true" style="color:var(--danger)">*</span></label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Re-enter password" required autocomplete="new-password" aria-required="true">
      </div>
      <button type="submit" class="btn btn-primary btn-block" style="margin-top:4px;">Create Institution Account</button>
    </form>

    <div class="auth-divider"><span>Already registered?</span></div>
    <a href="/org/login" class="btn btn-outline btn-block">Login to Dashboard</a>

    <p style="text-align:center; margin-top:20px; font-size:0.78rem; color:var(--ink-muted);">
      By registering, you agree to our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.
    </p>
  </div>
</div>

<%- include('../partials/footer') %>

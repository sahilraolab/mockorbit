<%- include('partials/header') %>

<section style="min-height: calc(100vh - 120px); display: flex; align-items: center; padding: 40px 0;">
  <div class="container-sm" style="max-width: 420px;">
    <div class="text-center mb-6">
      <h2>Welcome back</h2>
      <p class="mt-2">Login with your mobile number — no password needed.</p>
    </div>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error">⚠️ <%= error[0] %></div>
    <% } %>

    <div class="card">
      <form id="loginForm" autocomplete="off">
        <input type="hidden" id="returnTo" value="<%= returnTo || '/dashboard' %>">

        <div id="loginMsg" class="alert hidden" style="margin-bottom: 16px;"></div>

        <div class="form-group">
          <label class="form-label" for="mobile">Mobile Number</label>
          <div style="display: flex; gap: 10px; align-items: stretch;">
            <span style="display: flex; align-items: center; padding: 0 12px; background: var(--canvas-soft); border: 1.5px solid var(--border); border-radius: var(--radius); font-size: 0.9rem; color: var(--ink-soft); white-space: nowrap;">+91</span>
            <input type="tel" id="mobile" name="mobile" class="form-control" placeholder="98765 43210" maxlength="10" pattern="\d{10}" required style="flex: 1;">
          </div>
        </div>

        <button type="button" id="sendOtpBtn" class="btn btn-primary btn-block btn-lg">Send OTP</button>

        <div id="otpSection" class="hidden" style="margin-top: 20px;">
          <div class="divider"></div>
          <div class="form-group">
            <label class="form-label" for="otp">Enter OTP</label>
            <input type="text" id="otp" name="otp" class="form-control" placeholder="6-digit OTP" maxlength="6" inputmode="numeric" style="text-align: center; letter-spacing: 0.3em; font-size: 1.4rem; font-weight: 700;">
            <p class="text-xs text-muted mt-2">OTP is valid for 10 minutes.</p>
          </div>
          <button type="button" id="verifyBtn" class="btn btn-primary btn-block btn-lg">Verify & Login</button>
        </div>
      </form>
    </div>

    <p class="text-center text-small text-muted mt-4">
      By logging in, you agree to our terms of service.
    </p>
  </div>
</section>

<%- include('partials/footer') %>

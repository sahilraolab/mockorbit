<%- include('partials/footer') %>

<script>
document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('.faq-question').forEach(b => {
      b.setAttribute('aria-expanded', 'false');
      document.getElementById(b.getAttribute('aria-controls')).classList.remove('open');
    });
    if (!expanded) {
      btn.setAttribute('aria-expanded', 'true');
      document.getElementById(btn.getAttribute('aria-controls')).classList.add('open');
    }
  });
});

// Mock showcase carousel arrows
(function() {
  const track = document.getElementById('mockTrack');
  const prev  = document.getElementById('mockPrev');
  const next  = document.getElementById('mockNext');
  if (!track || !prev || !next) return;
  const scrollBy = 318;
  prev.addEventListener('click', () => track.scrollBy({ left: -scrollBy, behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  scrollBy, behavior: 'smooth' }));
})();
</script>

<%- include('partials/header') %>

<!-- Flash messages -->
<% if (error && error.length > 0) { %>
  <div class="container mt-4" role="alert" aria-live="assertive">
    <div class="alert alert-error">⚠️ <%= error[0] %></div>
  </div>
<% } %>
<% if (success && success.length > 0) { %>
  <div class="container mt-4" role="status" aria-live="polite">
    <div class="alert alert-success">✓ <%= success[0] %></div>
  </div>
<% } %>

<!-- ===== HERO ===== -->
<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-badge" aria-label="Platform highlight">
      🚀 India's Most Focused Mock Test Platform
    </div>
    <h1 id="hero-heading">
      Prepare Smarter.<br>
      <span class="highlight">Rank Higher.</span>
    </h1>
    <p class="hero-sub">
      Full-length mock tests built for Judiciary, CLAT, SSC CGL, and 20+ competitive exams — with real-time rank analytics, AI-powered weak-area reports, and expert solutions.
    </p>
    <div class="hero-cta">
      <a href="#exams" class="btn btn-primary btn-lg" aria-label="Browse all exam test series">Explore Test Series</a>
      <a href="/org/register" class="btn btn-navy btn-lg" aria-label="Register your institution on MockOrbit">For Institutions</a>
      <% if (!user) { %><a href="/auth/login" class="btn btn-outline btn-lg" aria-label="Login or create a free account">Login Free</a><% } %>
    </div>
    <p class="hero-trust" aria-label="Trust indicators">
      ⭐ Trusted by <strong style="color:var(--ink);margin:0 2px;">50,000+</strong> students &nbsp;·&nbsp;
      📚 <strong style="color:var(--ink);margin:0 2px;">200+</strong> mock tests &nbsp;·&nbsp;
      🏛️ <strong style="color:var(--ink);margin:0 2px;">150+</strong> partner institutes
    </p>
  </div>
</section>

<!-- ===== STATS ===== -->
<section class="stats-bar" aria-label="Platform statistics">
  <div class="container">
    <div class="stats-grid" role="list">
      <div class="stat-item" role="listitem">
        <div class="stat-number"><span>50K</span>+</div>
        <div class="stat-label">Students Enrolled</div>
      </div>
      <div class="stat-item" role="listitem">
        <div class="stat-number"><span>200</span>+</div>
        <div class="stat-label">Mock Tests</div>
      </div>
      <div class="stat-item" role="listitem">
        <div class="stat-number"><span>95</span>%</div>
        <div class="stat-label">Selection Rate</div>
      </div>
      <div class="stat-item" role="listitem">
        <div class="stat-number"><span>150</span>+</div>
        <div class="stat-label">Partner Institutes</div>
      </div>
      <div class="stat-item" role="listitem">
        <div class="stat-number"><span>10K</span>+</div>
        <div class="stat-label">Questions in Bank</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== EXAM CATEGORIES ===== -->
<section class="section" id="exams" aria-labelledby="exams-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Test Series</span>
      <h2 id="exams-heading">Choose Your Exam</h2>
      <p>Curated mock tests crafted by subject matter experts, aligned with the latest exam patterns and syllabi.</p>
    </div>

    <% if (exams.length === 0) { %>
      <div class="empty-state" role="status">
        <div class="empty-state-icon" aria-hidden="true">📚</div>
        <h3>No exams yet</h3>
        <p>Check back soon — we're adding new test series.</p>
      </div>
    <% } else { %>
      <div class="card-grid" role="list">
        <% exams.forEach(exam => { %>
          <a href="/series/exam/<%= exam.slug %>" class="exam-card" role="listitem" aria-label="<%= exam.name %> mock test series">
            <span class="exam-icon" aria-hidden="true"><%= exam.icon %></span>
            <div class="exam-name"><%= exam.name %></div>
            <% if (exam.description) { %>
              <p class="text-small text-muted mt-2"><%= exam.description %></p>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<!-- ===== HOW IT WORKS ===== -->
<section class="section" style="background: var(--canvas-soft); border-top: 1px solid var(--border);" aria-labelledby="how-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">How It Works</span>
      <h2 id="how-heading">Your Path to Success in 3 Steps</h2>
      <p>From choosing your exam to cracking it — MockOrbit guides every step of your preparation journey.</p>
    </div>

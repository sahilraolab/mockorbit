<%- include('partials/header') %>

<!-- Flash messages -->
<% if (error && error.length > 0) { %>
  <div class="container mt-4" role="alert" aria-live="assertive">
    <div class="alert alert-error">⚠️ <%= error[0] %></div>
  </div>
<% } %>
<% if (success && success.length > 0) { %>
  <div class="container mt-4" role="status" aria-live="polite">
    <div class="alert alert-success">✓ <%= success[0] %></div>
  </div>
<% } %>

<!-- ===== MOCK SHOWCASE ===== -->
<% if (tickerSeries && tickerSeries.length > 0) { %>
<section class="mock-showcase" aria-label="Available mock test series">
  <div class="mock-showcase-layout">

    <!-- Left: heading + info + nav -->
    <div class="mock-showcase-left">
      <span class="mock-showcase-live"><span class="mock-live-dot"></span>Live Now</span>
      <h2 class="mock-showcase-title">Available<br>Mock Tests</h2>
      <p class="mock-showcase-sub">Full-length mocks matching the exact exam pattern — attempt and get your All-India rank instantly.</p>
      <div class="mock-showcase-meta">
        <div class="mock-meta-item"><span class="mock-meta-val"><%= tickerSeries.length %></span><span class="mock-meta-lbl">Series Live</span></div>
        <div class="mock-meta-divider"></div>
        <div class="mock-meta-item"><span class="mock-meta-val">All-India</span><span class="mock-meta-lbl">Rank After Test</span></div>
      </div>
      <div class="mock-showcase-nav" aria-label="Carousel navigation">
        <button class="mock-nav-btn" id="mockPrev" aria-label="Previous">&#8592;</button>
        <button class="mock-nav-btn" id="mockNext" aria-label="Next">&#8594;</button>
      </div>
    </div>

    <!-- Right: scrollable cards -->
    <div class="mock-showcase-right">
      <div class="mock-showcase-track" id="mockTrack">
        <% tickerSeries.forEach(s => {
             const exam = s.examId || {};
             const examSlug = exam.slug || '';
             const href = examSlug ? '/series/exam/' + examSlug : '/series/' + s._id;
        %>
        <a href="<%= href %>" class="mock-card" aria-label="<%= s.title %>">
          <div class="mock-card-top">
            <div class="mock-card-icon-wrap">
              <span><%= exam.icon || '📚' %></span>
            </div>
            <div>
              <div class="mock-card-exam-name"><%= exam.name || s.title %></div>
              <% if (exam.conductedBy) { %><div class="mock-card-by"><%= exam.conductedBy %></div><% } %>
            </div>
          </div>

          <div class="mock-card-mid">
            <div class="mock-card-series-title"><%= s.title %></div>
            <% if (s.description) { %>
              <p class="mock-card-desc"><%= s.description %></p>
            <% } %>
          </div>

          <div class="mock-card-stats">
            <% if (s.totalMocks) { %>
            <div class="mock-stat">
              <span class="mock-stat-val"><%= s.totalMocks %></span>
              <span class="mock-stat-lbl">Mock<%= s.totalMocks > 1 ? 's' : '' %></span>
            </div>
            <% } %>
            <% if (exam.totalMarks) { %>
            <div class="mock-stat">
              <span class="mock-stat-val"><%= exam.totalMarks %></span>
              <span class="mock-stat-lbl">Marks</span>
            </div>
            <% } %>
            <% if (exam.examDuration) { %>
            <div class="mock-stat">
              <span class="mock-stat-val"><%= exam.examDuration %></span>
              <span class="mock-stat-lbl">Duration</span>
            </div>
            <% } %>
          </div>

          <div class="mock-card-footer">
            <% if (s.price === 0) { %>
              <div class="mock-card-price-tag mock-card-price-free">Start Now</div>
            <% } else { %>
              <div class="mock-card-price-tag">₹<%= s.price.toLocaleString('en-IN') %></div>
            <% } %>
            <span class="mock-card-cta">Explore →</span>
          </div>
        </a>
        <% }) %>
      </div>
    </div>

  </div>
</section>
<% } %>

<!-- ===== HERO ===== -->
<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-layout">

      <div class="hero-left">
        <div class="hero-badge" aria-label="Platform tagline">
          ⚖️ Mission for Academic Rank &amp; Success
        </div>
        <h1 id="hero-heading">
          Prepare Smarter.<br>
          <span class="highlight">Rank Higher.</span>
        </h1>
        <p class="hero-sub">
          Full-length mock tests for AIBE XXI and upcoming competitive exams — topic-wise analytics, detailed explanations, and an all-India rank among fellow aspirants.
        </p>
        <div class="hero-cta">
          <a href="#exams" class="btn btn-primary btn-lg" aria-label="Browse all exam test series">Explore Tests →</a>
          <% if (user) { %>
            <a href="/dashboard" class="btn btn-outline btn-lg">My Dashboard</a>
          <% } else { %>
            <a href="/auth/login" class="btn btn-outline btn-lg">Login Free</a>
          <% } %>
        </div>
        <div class="hero-trust" aria-label="Platform highlights">
          <div class="hero-trust-item"><strong>AIBE XXI</strong><span>June 2026</span></div>
          <div class="hero-trust-sep">·</div>
          <div class="hero-trust-item"><strong>380 Qs</strong><span>Full-Length Mock</span></div>
          <div class="hero-trust-sep">·</div>
          <div class="hero-trust-item"><strong>19 Topics</strong><span>Complete Syllabus</span></div>
          <div class="hero-trust-sep">·</div>
          <div class="hero-trust-item"><strong>Open Book</strong><span>Format</span></div>
        </div>
      </div>

      <!-- Right: Live exam cards from DB only -->
      <div class="hero-right" aria-hidden="true">
        <div class="hero-course-grid">
          <% if (exams.length > 0) { %>
            <% exams.slice(0, 4).forEach(exam => { %>
              <a href="/series/exam/<%= exam.slug %>" class="hero-course-card">
                <div class="hero-course-icon"><%= exam.icon || '📚' %></div>
                <div>
                  <div class="hero-course-name"><%= exam.name %></div>
                  <div class="hero-course-meta"><%= exam.category || 'Mock Tests' %></div>
                </div>
                <div class="hero-course-arrow">→</div>
              </a>
            <% }) %>
          <% } else { %>
            <a href="/series/exam/aibe-xxi" class="hero-course-card">
              <div class="hero-course-icon">⚖️</div>
              <div>
                <div class="hero-course-name">AIBE XXI</div>
                <div class="hero-course-meta">Law — Bar Exam</div>
              </div>
              <div class="hero-course-arrow">→</div>
            </a>
          <% } %>
        </div>
        <div class="hero-float-badge">
          ⚖️ AIBE XXI — June 2026
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ===== STATS BAR ===== -->
<section class="stats-bar" aria-label="Platform highlights">
  <div class="container">
    <div class="stats-grid" role="list">
      <div class="stat-item" role="listitem">
        <span class="stat-icon">📝</span>
        <div class="stat-number">Full-<span>Length</span></div>
        <div class="stat-label">Exam-Pattern Mocks</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">📊</span>
        <div class="stat-number">Live <span>Rank</span></div>
        <div class="stat-label">After Every Test</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">🧠</span>
        <div class="stat-number">Topic <span>Analysis</span></div>
        <div class="stat-label">Know Where to Improve</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">💡</span>
        <div class="stat-number">Detailed <span>Solutions</span></div>
        <div class="stat-label">For Every Question</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">📱</span>
        <div class="stat-number">Mobile <span>Ready</span></div>
        <div class="stat-label">Attempt Anywhere</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== EXAM CATEGORIES ===== -->
<section class="section exam-section" id="exams" aria-labelledby="exams-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Test Series</span>
      <h2 id="exams-heading">Choose Your Exam</h2>
      <p>We currently offer full-length mock tests for AIBE XXI. More series — CLAT, Judiciary, UPSC, SSC CGL, and Current Affairs — are coming soon.</p>
    </div>

    <% if (exams.length === 0) { %>
      <div class="empty-state" role="status">
        <div class="empty-state-icon" aria-hidden="true">📚</div>
        <h3>No exams yet</h3>
        <p>Check back soon — we're adding new test series.</p>
      </div>
    <% } else { %>
      <%
        const grouped = {};
        exams.forEach(exam => {
          const cat = exam.category || 'Other';
          if (!grouped[cat]) grouped[cat] = [];
          grouped[cat].push(exam);
        });
        const categoryOrder = ['Law Entrance','Judiciary','SSC','Banking','UPSC','State PSC','Railway','Defence','Teaching','Other'];
        const sortedCategories = categoryOrder.filter(c => grouped[c]);
        Object.keys(grouped).forEach(c => { if (!sortedCategories.includes(c)) sortedCategories.push(c); });
      %>

      <div class="exam-categories-wrap">
        <% sortedCategories.forEach(cat => { %>
          <div class="exam-cat-block">
            <div class="exam-cat-header">
              <span class="exam-cat-dot"></span>
              <span class="exam-cat-name"><%= cat %></span>
              <span class="exam-cat-count"><%= grouped[cat].length %> exam<%= grouped[cat].length > 1 ? 's' : '' %></span>
            </div>
            <div class="exam-card-grid">
              <% grouped[cat].forEach(exam => { %>
                <a href="/series/exam/<%= exam.slug %>"
                   class="exam-card-item"
                   aria-label="<%= exam.name %> mock test series"
                   itemscope itemtype="https://schema.org/Course">

                  <!-- Header band -->
                  <div class="exam-ci-header">
                    <div class="exam-ci-icon-wrap" aria-hidden="true"><%= exam.icon || '📚' %></div>
                    <div class="exam-ci-headtext">
                      <div class="exam-ci-title" itemprop="name"><%= exam.name %></div>
                      <% if (exam.conductedBy) { %>
                        <div class="exam-ci-by">by <%= exam.conductedBy %></div>
                      <% } %>
                    </div>
                  </div>

                  <!-- Body -->
                  <div class="exam-ci-body">
                    <% if (exam.description) { %>
                      <div class="exam-ci-desc" itemprop="description"><%= exam.description %></div>
                    <% } %>

                    <!-- All tag pills -->
                    <div class="exam-ci-tags">
                      <% if (exam.examLevel) { %>
                        <span class="exam-tag-pill exam-tag-level">
                          <%= exam.examLevel === 'National' ? '🇮🇳' : exam.examLevel === 'State' ? '📍' : '🏛️' %>
                          <%= exam.examLevel %>
                        </span>
                      <% } %>
                      <% if (exam.language && exam.language.length > 0) { %>
                        <% exam.language.forEach(lang => { %>
                          <span class="exam-tag-pill exam-tag-lang">🌐 <%= lang %></span>
                        <% }) %>
                      <% } %>
                      <% if (exam.frequency) { %>
                        <span class="exam-tag-pill exam-tag-freq">🔄 <%= exam.frequency %></span>
                      <% } %>
                    </div>

                    <% if (exam.eligibility) { %>
                      <div class="exam-ci-elig">
                        <strong>Eligibility:</strong> <%= exam.eligibility %>
                      </div>
                    <% } %>
                  </div>

                  <!-- Footer -->
                  <div class="exam-ci-footer">
                    <div class="exam-ci-stats">
                      <% if (exam.totalMarks) { %>
                        <div class="exam-ci-stat">
                          <span class="exam-ci-stat-val"><%= exam.totalMarks %></span>
                          <span class="exam-ci-stat-key">Marks</span>
                        </div>
                      <% } %>
                      <% if (exam.examDuration) { %>
                        <div class="exam-ci-stat">
                          <span class="exam-ci-stat-val"><%= exam.examDuration %></span>
                          <span class="exam-ci-stat-key">Duration</span>
                        </div>
                      <% } %>
                    </div>
                    <span class="exam-ci-cta">Explore Tests →</span>
                  </div>

                </a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<!-- ===== HOW IT WORKS ===== -->

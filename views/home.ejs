<%- include('partials/header') %>

<!-- Flash messages -->
<% if (error && error.length > 0) { %>
  <div class="container mt-4" role="alert" aria-live="assertive">
    <div class="alert alert-error">⚠️ <%= error[0] %></div>
  </div>
<% } %>
<% if (success && success.length > 0) { %>
  <div class="container mt-4" role="status" aria-live="polite">
    <div class="alert alert-success">✓ <%= success[0] %></div>
  </div>
<% } %>

<!-- ===== MOCK SHOWCASE ===== -->
<% if (tickerSeries && tickerSeries.length > 0) { %>
<section class="mock-showcase" aria-label="Available mock test series">
  <div class="mock-showcase-layout">

    <!-- Left: heading + info + nav -->
    <div class="mock-showcase-left">
      <span class="mock-showcase-live"><span class="mock-live-dot"></span>Live Now</span>
      <h2 class="mock-showcase-title">Available<br>Mock Tests</h2>
      <p class="mock-showcase-sub">Full-length mocks matching the exact exam pattern — attempt and get your All-India rank instantly.</p>
      <div class="mock-showcase-meta">
        <div class="mock-meta-item"><span class="mock-meta-val"><%= tickerSeries.length %></span><span class="mock-meta-lbl">Series Live</span></div>
        <div class="mock-meta-divider"></div>
        <div class="mock-meta-item"><span class="mock-meta-val">Open Book</span><span class="mock-meta-lbl">Format</span></div>
      </div>
      <div class="mock-showcase-nav" aria-label="Carousel navigation">
        <button class="mock-nav-btn" id="mockPrev" aria-label="Previous">&#8592;</button>
        <button class="mock-nav-btn" id="mockNext" aria-label="Next">&#8594;</button>
      </div>
    </div>

    <!-- Right: scrollable cards -->
    <div class="mock-showcase-right">
      <div class="mock-showcase-track" id="mockTrack">
        <% tickerSeries.forEach(s => {
             const exam = s.examId || {};
             const href = '/series/' + s._id;
        %>
        <%
          const mockLangsSlider = s.mockLanguages && s.mockLanguages.length > 0
            ? s.mockLanguages : (exam.language || []);
        %>
        <a href="<%= href %>" class="mock-card" aria-label="<%= s.title %>">

          <!-- Exam context — tiny -->
          <div class="mock-card-top">
            <div class="mock-card-icon-wrap" aria-hidden="true">
              <span><%= exam.icon || '📚' %></span>
            </div>
            <div>
              <div class="mock-card-exam-name"><%= exam.name || s.title %></div>
              <div class="mock-card-series-sub"><%= s.totalMocks %> Full-Length Mock<%= s.totalMocks > 1 ? 's' : '' %></div>
            </div>
            <% if (s.price === 0) { %><span class="mock-card-free-badge">Free</span><% } %>
          </div>

          <!-- Product info -->
          <div class="mock-card-mid">
            <div class="mock-card-series-title"><%= s.title %></div>
            <% if (s.description) { %>
              <p class="mock-card-desc"><%= s.description %></p>
            <% } %>

            <!-- Mock languages — only show if available -->
            <% if (mockLangsSlider.length > 0) { %>
              <div class="mock-card-lang-row">
                <span class="mock-card-lang-label">Mock available in</span>
                <div class="mock-card-langs">
                  <% mockLangsSlider.forEach(lang => { %>
                    <span class="mock-card-lang"><%= lang %></span>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <!-- CTA -->
          <div class="mock-card-footer">
            <% if (s.price === 0) { %>
              <span class="mock-card-cta-btn mock-card-cta-free">Access Free →</span>
            <% } else { %>
              <span class="mock-card-cta-btn">Buy Now — ₹<%= s.price.toLocaleString('en-IN') %> →</span>
            <% } %>
          </div>

        </a>
        <% }) %>
      </div>
    </div>

  </div>
</section>
<% } %>

<!-- ===== HERO ===== -->
<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-layout">

      <div class="hero-left">
        <%
          const heroHeading = (siteSettings && siteSettings.hero_heading)
            ? siteSettings.hero_heading
            : 'Mission for Academic\nRank & Success';
          const heroSub = (siteSettings && siteSettings.hero_sub)
            ? siteSettings.hero_sub
            : 'Full-length mock tests for top competitive exams — topic-wise analytics, detailed explanations, and an all-India rank among fellow aspirants.';
          // Split heading on '\n' so admin can add a line break
          const headingParts = heroHeading.split('\n');
        %>
        <h1 id="hero-heading">
          <% headingParts.forEach((part, i) => { %>
            <% if (i < headingParts.length - 1) { %>
              <%= part %><br>
            <% } else { %>
              <span class="highlight"><%= part %></span>
            <% } %>
          <% }) %>
        </h1>
        <p class="hero-sub"><%= heroSub %></p>
        <div class="hero-cta">
          <a href="#exams" class="btn btn-primary btn-lg" aria-label="Explore all mock test series">Explore Mock Tests →</a>
          <% if (user) { %>
            <a href="/dashboard" class="btn btn-outline btn-lg">My Dashboard</a>
          <% } else { %>
            <a href="/auth/login" class="btn btn-outline btn-lg">Login Free</a>
          <% } %>
        </div>
      </div>

      <!-- Right: Featured series prep card (dynamic) -->
      <div class="hero-right" aria-hidden="true">
        <% if (featuredSeries) { %>
        <%
          const fs = featuredSeries;
          const fsLabel = fs.category || (fs.examId && fs.examId.name) || 'Mock Test Series';
          const fsMocks = fs._testCount || fs.totalMocks || 0;
          const fsQs    = fs._totalQuestions || 0;
          const fsTopicCount = featuredTopics.length;
          // Bar widths relative to the top topic's count
          const maxTopicCount = featuredTopics.length > 0 ? featuredTopics[0].count : 1;
        %>
        <div class="hrc-wrap">
          <div class="hrc-blob hrc-blob-1"></div>
          <div class="hrc-blob hrc-blob-2"></div>

          <div class="hrc-card">
            <div class="hrc-card-header">
              <span class="hrc-dot"></span>
              <span class="hrc-header-text">Prepare for <%= fsLabel %></span>
            </div>

            <div class="hrc-rank-block">
              <div class="hrc-rank-label">Featured Test Series</div>
              <div class="hrc-rank-num" style="font-size:1.55rem;line-height:1.15;letter-spacing:-0.3px;"><%= fs.title %></div>
              <% if (fs.mockLanguages && fs.mockLanguages.length > 0) { %>
                <div class="hrc-rank-sub">🌐 <%= fs.mockLanguages.join(' · ') %></div>
              <% } %>
            </div>

            <div class="hrc-stats-row">
              <div class="hrc-stat">
                <div class="hrc-stat-val"><%= fsMocks %></div>
                <div class="hrc-stat-lbl">Mocks</div>
              </div>
              <div class="hrc-stat-div"></div>
              <div class="hrc-stat">
                <div class="hrc-stat-val"><%= fsQs > 0 ? fsQs.toLocaleString('en-IN') : '—' %></div>
                <div class="hrc-stat-lbl">Questions</div>
              </div>
              <div class="hrc-stat-div"></div>
              <div class="hrc-stat">
                <% if (fs.price === 0) { %>
                  <div class="hrc-stat-val" style="color:var(--success);font-size:1rem;">Free</div>
                <% } else { %>
                  <div class="hrc-stat-val" style="font-size:1rem;">₹<%= fs.price.toLocaleString('en-IN') %></div>
                <% } %>
                <div class="hrc-stat-lbl">Price</div>
              </div>
            </div>

            <% if (featuredTopics.length > 0) { %>
            <div class="hrc-topics">
              <% featuredTopics.forEach(t => {
                   const pct = Math.round((t.count / maxTopicCount) * 100);
              %>
              <div class="hrc-topic-row">
                <span class="hrc-topic-name"><%= t.name %></span>
                <div class="hrc-bar-track"><div class="hrc-bar-fill" style="--w:<%= pct %>%"></div></div>
                <span class="hrc-topic-pct"><%= t.count %> Qs</span>
              </div>
              <% }) %>
            </div>
            <% } %>

            <div class="hrc-footer">
              <span class="hrc-footer-text">📊 All-India rank after every mock</span>
            </div>
          </div>

          <div class="hrc-float-badge hrc-float-left">
            <span class="hrc-fb-icon">📋</span>
            <div>
              <div class="hrc-fb-val"><%= fsMocks %> Mocks</div>
              <div class="hrc-fb-lbl">Full-Length</div>
            </div>
          </div>
          <div class="hrc-float-badge hrc-float-right">
            <span class="hrc-fb-icon">🏆</span>
            <div>
              <div class="hrc-fb-val">All India</div>
              <div class="hrc-fb-lbl">Rank</div>
            </div>
          </div>
        </div>
        <% } %>
      </div>

    </div>
  </div>
</section>

<!-- ===== STATS BAR ===== -->
<section class="stats-bar" aria-label="Platform highlights">
  <div class="container">
    <div class="stats-grid" role="list">
      <div class="stat-item" role="listitem">
        <span class="stat-icon">📝</span>
        <div class="stat-number">Full-<span>Length</span></div>
        <div class="stat-label">Exam-Pattern Mocks</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">📊</span>
        <div class="stat-number">Live <span>Rank</span></div>
        <div class="stat-label">After Every Test</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">🧠</span>
        <div class="stat-number">Topic <span>Analysis</span></div>
        <div class="stat-label">Know Where to Improve</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">💡</span>
        <div class="stat-number">Detailed <span>Solutions</span></div>
        <div class="stat-label">For Every Question</div>
      </div>
      <div class="stat-item" role="listitem">
        <span class="stat-icon">📱</span>
        <div class="stat-number">Mobile <span>Ready</span></div>
        <div class="stat-label">Attempt Anywhere</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== TEST SERIES ===== -->
<section class="section ts-section" id="exams" aria-labelledby="ts-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Mock Test Series</span>
      <h2 id="ts-heading">Find Your Test Series</h2>
      <p>Full-length mock tests built for the exact pattern of each exam — attempt, rank, and improve.</p>
    </div>

    <% if (series.length === 0) { %>
      <div class="empty-state" role="status">
        <div class="empty-state-icon" aria-hidden="true">📚</div>
        <h3>No test series yet</h3>
        <p>Check back soon — we're adding new series.</p>
      </div>
    <% } else { %>

      <!-- Filter bar -->
      <div class="ts-filter-bar" role="search" aria-label="Filter test series">

        <!-- Row 1: Category tabs -->
        <div class="ts-filter-row">
          <span class="ts-filter-label" id="catFilterLabel">Category</span>
          <div class="ts-cat-pills" id="tsCatPills" role="group" aria-labelledby="catFilterLabel">
            <button class="ts-cat-pill active" data-cat="" aria-pressed="true">All</button>
            <% categories.forEach(cat => { %>
              <button class="ts-cat-pill" data-cat="<%= cat %>" aria-pressed="false"><%= cat %></button>
            <% }) %>
          </div>
        </div>

        <!-- Row 2: Language + Price -->
        <div class="ts-filter-row ts-filter-row-secondary">
          <% if (languages.length > 0) { %>
          <div class="ts-filter-group">
            <label class="ts-filter-label" for="tsLangFilter">Language</label>
            <div class="ts-select-wrap">
              <select id="tsLangFilter" class="ts-filter-select" aria-label="Filter by mock language">
                <option value="">All Languages</option>
                <% languages.forEach(l => { %><option value="<%= l %>"><%= l %></option><% }) %>
              </select>
            </div>
          </div>
          <% } %>

          <div class="ts-filter-group">
            <span class="ts-filter-label" id="priceFilterLabel">Price</span>
            <div class="ts-price-pills" role="group" aria-labelledby="priceFilterLabel">
              <button class="ts-price-pill active" data-price="" aria-pressed="true">All</button>
              <button class="ts-price-pill" data-price="free" aria-pressed="false">Free</button>
              <button class="ts-price-pill" data-price="paid" aria-pressed="false">Paid</button>
            </div>
          </div>

          <button class="ts-clear-btn" id="tsClearFilters" aria-label="Clear all filters" style="display:none;">
            ✕ Clear filters
          </button>
        </div>

      </div>

      <!-- Result count -->
      <p class="ts-result-count" id="tsCount" aria-live="polite" aria-atomic="true"><%= series.length %> series available</p>

      <!-- Series grid -->
      <div class="ts-grid" id="tsGrid">
        <% series.forEach(s => {
             const exam     = s.examId || {};
             const href     = '/series/' + s._id;
             const mockLangs = s.mockLanguages && s.mockLanguages.length > 0 ? s.mockLanguages : [];
             const features  = (s.features || []).slice(0, 4);
             const seriesCat = s.category || exam.category || '';
             const seriesLabel = s.category || exam.name || 'Mock Test Series';
        %>
        <a href="<%= href %>"
           class="sc-card"
           data-cat="<%= seriesCat %>"
           data-langs="<%= mockLangs.join(',').toLowerCase() %>"
           data-price="<%= s.price === 0 ? 'free' : 'paid' %>"
           aria-label="<%= s.title %>"
           itemscope itemtype="https://schema.org/Course">

          <!-- Category label -->
          <div class="sc-exam-label">
            <span class="sc-exam-icon"><%= exam.icon || '📝' %></span>
            <span class="sc-exam-name"><%= seriesLabel %></span>
            <% if (s.price === 0) { %><span class="sc-badge-free">Free</span><% } %>
          </div>

          <!-- Product body — this is what we're selling -->
          <div class="sc-card-body">
            <div class="sc-card-title" itemprop="name"><%= s.title %></div>
            <% if (s.description) { %>
              <p class="sc-card-desc" itemprop="description"><%= s.description %></p>
            <% } %>

            <!-- What's included — the sell -->
            <% if (features.length > 0) { %>
            <ul class="sc-includes-list">
              <% features.forEach(f => { %><li><%= f %></li><% }) %>
            </ul>
            <% } %>

            <!-- Mock languages — useful signal -->
            <% if (mockLangs.length > 0) { %>
            <div class="sc-langs">
              <% mockLangs.forEach(l => { %><span class="sc-lang-pill">🌐 <%= l %></span><% }) %>
            </div>
            <% } %>
          </div>

          <!-- Footer: mocks count + questions + price + CTA -->
          <div class="sc-card-footer">
            <div class="sc-mocks-count">
              <span class="sc-mocks-num"><%= s.totalMocks %></span>
              <span class="sc-mocks-lbl">Mock<%= s.totalMocks > 1 ? 's' : '' %></span>
              <% if (s._totalQuestions > 0) { %>
                <span class="sc-mocks-sep">·</span>
                <span class="sc-mocks-num"><%= s._totalQuestions.toLocaleString('en-IN') %></span>
                <span class="sc-mocks-lbl">Questions</span>
              <% } %>
            </div>
            <% if (s.price === 0) { %>
              <span class="sc-cta-btn sc-cta-free">Access Free →</span>
            <% } else { %>
              <span class="sc-cta-btn">Buy ₹<%= s.price.toLocaleString('en-IN') %> →</span>
            <% } %>
          </div>

        </a>
        <% }) %>
      </div>

      <!-- No results message -->
      <div class="ts-no-results" id="tsNoResults" style="display:none;" role="status">
        <div class="empty-state-icon">🔍</div>
        <h4>No series match your filters</h4>
        <p>Try selecting a different category or language.</p>
      </div>

    <% } %>
  </div>
</section>

<!-- ===== HOW IT WORKS ===== -->
<section class="section" style="background: var(--canvas-soft); border-top: 1px solid var(--border);" aria-labelledby="how-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">How It Works</span>
      <h2 id="how-heading">Your Path to Success in 3 Steps</h2>
      <p>From choosing your exam to analysing your performance — MockOrbit guides every step of your preparation.</p>
    </div>
    <div class="how-steps">
      <div class="how-step">
        <div class="how-step-num" aria-hidden="true">1</div>
        <h4>Pick Your Exam</h4>
        <p>Browse our available test series. We currently offer AIBE XXI mock tests, with CLAT, Judiciary, UPSC, SSC CGL, and Current Affairs series coming soon.</p>
      </div>
      <div class="how-step">
        <div class="how-step-num" aria-hidden="true">2</div>
        <h4>Take Mock Tests</h4>
        <p>Attempt full-length timed tests under real exam conditions — auto-saved, with a live question palette just like the actual exam.</p>
      </div>
      <div class="how-step">
        <div class="how-step-num" aria-hidden="true">3</div>

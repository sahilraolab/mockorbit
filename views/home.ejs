<script>
document.querySelectorAll('.faq-question').forEach(btn => {
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    document.querySelectorAll('.faq-question').forEach(b => {
      b.setAttribute('aria-expanded', 'false');
      document.getElementById(b.getAttribute('aria-controls')).classList.remove('open');
    });
    if (!expanded) {
      btn.setAttribute('aria-expanded', 'true');
      document.getElementById(btn.getAttribute('aria-controls')).classList.add('open');
    }
  });
});

// Mock showcase carousel arrows
(function() {
  const track = document.getElementById('mockTrack');
  const prev  = document.getElementById('mockPrev');
  const next  = document.getElementById('mockNext');
  if (!track || !prev || !next) return;
  const scrollBy = 318;
  prev.addEventListener('click', () => track.scrollBy({ left: -scrollBy, behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  scrollBy, behavior: 'smooth' }));
})();

// Test Series filter
(function() {
  const grid        = document.getElementById('tsGrid');
  const countEl     = document.getElementById('tsCount');
  const noResults   = document.getElementById('tsNoResults');
  const langSel     = document.getElementById('tsLangFilter');
  const clearBtn    = document.getElementById('tsClearFilters');
  const catPills    = document.querySelectorAll('.ts-cat-pill');
  const pricePills  = document.querySelectorAll('.ts-price-pill');
  if (!grid) return;

  let activeCat   = '';
  let activeLang  = '';
  let activePrice = '';

  function hasActiveFilter() { return activeCat || activeLang || activePrice; }

  function applyFilters() {
    const cards = grid.querySelectorAll('.sc-card');
    let visible = 0;
    cards.forEach(card => {
      const cat   = card.dataset.cat   || '';
      const langs = card.dataset.langs || '';
      const price = card.dataset.price || '';

      const catOk   = !activeCat   || cat === activeCat;
      const langOk  = !activeLang  || langs.split(',').map(l=>l.trim()).includes(activeLang.toLowerCase());
      const priceOk = !activePrice || price === activePrice;

      const show = catOk && langOk && priceOk;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (countEl) countEl.textContent = visible + (visible === 1 ? ' series' : ' series') + ' available';
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    if (clearBtn)  clearBtn.style.display  = hasActiveFilter() ? 'inline-flex' : 'none';
  }

  function setPills(group, activeVal) {
    group.forEach(b => {
      const isActive = b.dataset.cat !== undefined
        ? b.dataset.cat === activeVal
        : b.dataset.price === activeVal;
      b.classList.toggle('active', isActive);
      b.setAttribute('aria-pressed', String(isActive));
    });
  }

  catPills.forEach(btn => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat;
      setPills(catPills, activeCat);
      applyFilters();
    });
  });

  pricePills.forEach(btn => {
    btn.addEventListener('click', () => {
      activePrice = btn.dataset.price;
      setPills(pricePills, activePrice);
      applyFilters();
    });
  });

  if (langSel) langSel.addEventListener('change', () => { activeLang = langSel.value; applyFilters(); });

  if (clearBtn) clearBtn.addEventListener('click', () => {
    activeCat = ''; activeLang = ''; activePrice = '';
    setPills(catPills,   '');
    setPills(pricePills, '');
    if (langSel) langSel.value = '';
    applyFilters();
  });
})();
</script>

<!-- ===== TESTIMONIALS (only if real data exists) ===== -->
<% if (testimonials && testimonials.length > 0) { %>
<section class="section" style="background:var(--canvas-soft); border-top:1px solid var(--border);" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Student Feedback</span>
      <h2 id="testimonials-heading">What Students Are Saying</h2>
      <p>Feedback from students who have used MockOrbit to prepare for their exams.</p>
    </div>
    <div class="testimonials-slider" id="testimonialSlider" aria-label="Student reviews">
      <% testimonials.slice(0, 6).forEach(t => { %>
        <article class="testimonial-card">
          <div class="testimonial-stars" aria-label="<%= t.rating %> star rating">
            <%= '★'.repeat(t.rating) %><%= '☆'.repeat(5 - t.rating) %>
          </div>
          <p class="testimonial-text">"<%= t.text %>"</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar" aria-hidden="true"><%= t.name[0].toUpperCase() %></div>
            <div>
              <div class="testimonial-name"><%= t.name %></div>
              <% if (t.role) { %><div class="testimonial-role"><%= t.role %></div><% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    <div class="slider-nav" aria-label="Slider navigation">
      <button class="slider-arrow" id="sliderPrev" aria-label="Previous reviews">‹</button>
      <div id="sliderDots" style="display:flex;gap:6px;align-items:center;"></div>
      <button class="slider-arrow" id="sliderNext" aria-label="Next reviews">›</button>
    </div>
  </div>
</section>
<% } %>


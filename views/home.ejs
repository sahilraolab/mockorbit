<!-- ===== FAQ ===== -->
<section class="section" aria-labelledby="faq-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">FAQ</span>
      <h2 id="faq-heading">Frequently Asked Questions</h2>
      <p>Everything you need to know about MockOrbit before you get started.</p>
    </div>
    <div class="faq-list" role="list" itemscope itemtype="https://schema.org/FAQPage">

      <div class="faq-item" role="listitem" itemscope itemtype="https://schema.org/Question" itemprop="mainEntity">
        <button class="faq-question" aria-expanded="false" aria-controls="faq-1" itemprop="name">
          Is MockOrbit free to use?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer" id="faq-1" role="region" itemscope itemtype="https://schema.org/Answer" itemprop="acceptedAnswer">
          <p itemprop="text">Creating an account and browsing exam categories is completely free. We offer both free preview questions and paid full-length test series at a one-time price — no subscription required.</p>
        </div>
      </div>

      <div class="faq-item" role="listitem" itemscope itemtype="https://schema.org/Question" itemprop="mainEntity">
        <button class="faq-question" aria-expanded="false" aria-controls="faq-2" itemprop="name">
          Which exams does MockOrbit currently cover?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer" id="faq-2" role="region" itemscope itemtype="https://schema.org/Answer" itemprop="acceptedAnswer">
          <p itemprop="text">MockOrbit currently offers full-length mock tests for AIBE XXI (All India Bar Examination). We are actively working on adding CLAT, Judiciary (PCS-J / HJS), UPSC, SSC CGL, and Current Affairs series. Contact us to be notified when your exam is added.</p>
        </div>
      </div>

      <div class="faq-item" role="listitem" itemscope itemtype="https://schema.org/Question" itemprop="mainEntity">
        <button class="faq-question" aria-expanded="false" aria-controls="faq-3" itemprop="name">
          What is AIBE and who should take this mock test?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer" id="faq-3" role="region" itemscope itemtype="https://schema.org/Answer" itemprop="acceptedAnswer">
          <p itemprop="text">AIBE (All India Bar Examination) is a mandatory qualifying exam conducted by the Bar Council of India Trust for advocates who wish to practise law in India. If you are an LLB or BA LLB graduate enrolled with a State Bar Council and appearing in AIBE XXI (June 2026), our mock covers all 19 law topics across 380 questions — matching the actual exam pattern with open-book format and no negative marking.</p>
        </div>
      </div>

      <div class="faq-item" role="listitem" itemscope itemtype="https://schema.org/Question" itemprop="mainEntity">
        <button class="faq-question" aria-expanded="false" aria-controls="faq-4" itemprop="name">
          How does the rank system work?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer" id="faq-4" role="region" itemscope itemtype="https://schema.org/Answer" itemprop="acceptedAnswer">
          <p itemprop="text">After submitting a test, MockOrbit instantly calculates your rank compared to all other students who have attempted the same test. You also get your percentile score — showing what percentage of students you scored higher than.</p>
        </div>
      </div>

      <div class="faq-item" role="listitem" itemscope itemtype="https://schema.org/Question" itemprop="mainEntity">
        <button class="faq-question" aria-expanded="false" aria-controls="faq-5" itemprop="name">
          Can coaching centres and institutions use MockOrbit?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer" id="faq-5" role="region" itemscope itemtype="https://schema.org/Answer" itemprop="acceptedAnswer">
          <p itemprop="text">Yes. Any educational institution — coaching centres, schools, colleges, or universities — can register on MockOrbit for free. You get a dedicated dashboard to add students, assign tests, set deadlines, and track performance across your entire batch.</p>
        </div>
      </div>

      <div class="faq-item" role="listitem" itemscope itemtype="https://schema.org/Question" itemprop="mainEntity">
        <button class="faq-question" aria-expanded="false" aria-controls="faq-6" itemprop="name">
          How do I login? Is there a password?
          <span class="faq-icon" aria-hidden="true">+</span>
        </button>
        <div class="faq-answer" id="faq-6" role="region" itemscope itemtype="https://schema.org/Answer" itemprop="acceptedAnswer">
          <p itemprop="text">MockOrbit uses email OTP-based login — enter your email address, receive a 6-digit OTP in your inbox, and you're in. No passwords to remember. Sessions remain active for 7 days on trusted devices.</p>
        </div>
      </div>

    </div>
  </div>
</section>


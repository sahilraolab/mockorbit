      <span class="exam-tag" role="listitem">Judiciary (Civil Judge)</span>
      <span class="exam-tag exam-tag-featured" role="listitem">CLAT UG & PG</span>
      <span class="exam-tag" role="listitem">SSC CGL</span>
      <span class="exam-tag" role="listitem">SSC CHSL</span>
      <span class="exam-tag exam-tag-featured" role="listitem">Banking PO</span>
      <span class="exam-tag" role="listitem">IBPS Clerk</span>
      <span class="exam-tag" role="listitem">UPSC Prelims</span>
      <span class="exam-tag" role="listitem">UPSC EPFO</span>
      <span class="exam-tag exam-tag-featured" role="listitem">RBI Grade B</span>
      <span class="exam-tag" role="listitem">CUET PG Law</span>
      <span class="exam-tag" role="listitem">Delhi Judicial</span>
      <span class="exam-tag" role="listitem">MPPSC</span>
      <span class="exam-tag" role="listitem">UPPCS</span>
      <span class="exam-tag" role="listitem">And 10+ more</span>
    </div>
  </div>
</section>

<!-- For Institutions CTA -->

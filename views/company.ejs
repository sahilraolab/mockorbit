<%- include('partials/header') %>

<section class="static-hero" aria-labelledby="company-heading">
  <div class="container">
    <div class="static-hero-content">
      <span class="section-label">The Company</span>
      <h1 id="company-heading">Powering India's Most Focused<br><span class="highlight">Exam Preparation Platform</span></h1>
      <p class="static-hero-sub">MockOrbit is building the infrastructure for merit — giving every competitive exam aspirant in India the tools, content, and analytics to crack their target exam.</p>
    </div>
  </div>
</section>

<!-- Mission -->
<section class="section" aria-labelledby="company-mission-heading">
  <div class="container">
    <div class="company-mission-grid">
      <div class="company-mission-text">
        <span class="section-label">Our Mission</span>
        <h2 id="company-mission-heading">Democratising Exam Preparation Across India</h2>
        <p>India runs on competitive exams. From District Judge to SSC officer, millions of students invest years preparing for these transformative opportunities. Yet quality preparation has long been locked behind expensive coaching fees and limited geography.</p>
        <p>MockOrbit changes that. Our platform delivers the same level of preparation that top rankers get — full-length mock tests, real-time rank analytics, and expert explanations — to any student with a smartphone.</p>
      </div>
      <div class="company-mission-numbers">
        <div class="company-number-card">
          <div class="company-number">50K+</div>
          <div class="company-number-label">Registered Students</div>
        </div>
        <div class="company-number-card">
          <div class="company-number">20+</div>
          <div class="company-number-label">Competitive Exams</div>
        </div>
        <div class="company-number-card">
          <div class="company-number">150+</div>
          <div class="company-number-label">Partner Institutions</div>
        </div>
        <div class="company-number-card">
          <div class="company-number">10K+</div>
          <div class="company-number-label">Questions in Bank</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- What We Do -->
<section class="section bg-soft" aria-labelledby="what-we-do-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Our Platform</span>
      <h2 id="what-we-do-heading">What MockOrbit Delivers</h2>
      <p>A complete preparation ecosystem, not just a question bank.</p>
    </div>
    <div class="company-features-grid">
      <div class="company-feature">
        <div class="company-feature-num">01</div>
        <h3>Full-Length Mock Tests</h3>
        <p>Simulated tests mirroring the exact pattern, difficulty, and timing of Judiciary, CLAT, SSC CGL, Banking PO, UPSC Prelims, and more. Every test is reviewed by exam experts before publication.</p>
      </div>
      <div class="company-feature">
        <div class="company-feature-num">02</div>
        <h3>Real-Time Rank Analytics</h3>
        <p>Instantly see where you rank among all students who have attempted the same test. Section-wise performance breakdown, time-per-question analysis, and national percentile — all in one dashboard.</p>
      </div>
      <div class="company-feature">
        <div class="company-feature-num">03</div>
        <h3>AI-Powered Weak-Area Reports</h3>
        <p>Our system identifies patterns in your wrong answers across topics and question types, then surfaces the specific areas that, if improved, will have the highest impact on your rank.</p>
      </div>
      <div class="company-feature">
        <div class="company-feature-num">04</div>
        <h3>Institution Dashboard</h3>
        <p>Coaching institutes and law schools can enrol students, assign specific test series, and monitor cohort-level performance — all from a dedicated organisation dashboard.</p>
      </div>
    </div>
  </div>
</section>

<!-- Exams Coverage -->

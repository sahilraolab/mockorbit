<%- include('partials/header') %>

<section class="static-hero" aria-labelledby="company-heading">
  <div class="container">
    <div class="static-hero-content">
      <span class="section-label">The Company</span>
      <h1 id="company-heading">Mission for Academic<br><span class="highlight">Rank &amp; Success</span></h1>
      <p class="static-hero-sub">MockOrbit is a focused mock test platform helping competitive exam aspirants in India prepare with structure, measure their readiness with real rankings, and improve with topic-wise analytics.</p>
    </div>
  </div>
</section>

<!-- Mission -->
<section class="section" aria-labelledby="company-mission-heading">
  <div class="container">
    <div class="company-mission-grid">
      <div class="company-mission-text">
        <span class="section-label">Our Mission</span>
        <h2 id="company-mission-heading">Making Quality Preparation Accessible</h2>
        <p>Competitive exams in India determine careers — from law practice to government service. Yet quality mock test content has long been scattered, expensive, or incomplete, especially for students outside major cities.</p>
        <p>MockOrbit is built to close that gap. We start with AIBE XXI — a mandatory qualifying exam for every law graduate in India — and are building full-length mock series for CLAT, Judiciary, UPSC, SSC CGL, and Current Affairs next.</p>
      </div>
      <div class="company-mission-numbers">
        <div class="company-number-card">
          <div class="company-number">AIBE XXI</div>
          <div class="company-number-label">Our First Exam Series</div>
        </div>
        <div class="company-number-card">
          <div class="company-number">380</div>
          <div class="company-number-label">Questions per Full Mock</div>
        </div>
        <div class="company-number-card">
          <div class="company-number">19</div>
          <div class="company-number-label">Law Topics Covered</div>
        </div>
        <div class="company-number-card">
          <div class="company-number">Free</div>
          <div class="company-number-label">to Join &amp; Start</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- What We Do -->
<section class="section bg-soft" aria-labelledby="what-we-do-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Our Platform</span>
      <h2 id="what-we-do-heading">What MockOrbit Delivers</h2>
      <p>A structured preparation tool — not just a question bank.</p>
    </div>
    <div class="company-features-grid">
      <div class="company-feature">
        <div class="company-feature-num">01</div>
        <h3>Full-Length Mock Tests</h3>
        <p>Simulated tests matching the exact pattern, duration, and structure of the actual exam. Questions are reviewed before publication to ensure accuracy and relevance to the current syllabus.</p>
      </div>
      <div class="company-feature">
        <div class="company-feature-num">02</div>
        <h3>Real-Time Rank &amp; Analytics</h3>
        <p>Instantly see where you rank among all students who have attempted the same test. Topic-wise performance breakdown and percentile score — all in one results dashboard.</p>
      </div>
      <div class="company-feature">
        <div class="company-feature-num">03</div>
        <h3>Detailed Answer Explanations</h3>
        <p>Every question includes a clear explanation of the correct answer — the relevant provision, case reference, or reasoning — so each test attempt is also a learning session.</p>
      </div>
      <div class="company-feature">
        <div class="company-feature-num">04</div>
        <h3>Institution Dashboard</h3>
        <p>Any educational institution — coaching centres, schools, colleges, or universities — can register free, enrol students, assign tests, and monitor performance from a dedicated dashboard.</p>
      </div>
    </div>
  </div>
</section>

<!-- Current Exam Coverage -->
<section class="section" aria-labelledby="exams-coverage-heading">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">Exam Coverage</span>
      <h2 id="exams-coverage-heading">Available Now &amp; Coming Soon</h2>
    </div>
    <div class="exam-tags-cloud" role="list" aria-label="Available and upcoming exam series">
      <span class="exam-tag exam-tag-featured" role="listitem">⚖️ AIBE XXI — Available Now</span>
      <span class="exam-tag" role="listitem">CLAT — Coming Soon</span>
      <span class="exam-tag" role="listitem">Judiciary (PCS-J / HJS) — Coming Soon</span>
      <span class="exam-tag" role="listitem">UPSC — Coming Soon</span>
      <span class="exam-tag" role="listitem">SSC CGL — Coming Soon</span>
      <span class="exam-tag" role="listitem">Current Affairs — Coming Soon</span>
    </div>
    <p style="text-align:center; margin-top:24px; font-size:0.9rem; color:var(--ink-muted);">
      Want your exam added? <a href="/contact" style="color:var(--accent); font-weight:600;">Contact us →</a>
    </p>
  </div>
</section>

<!-- For Institutions CTA -->
<section class="section cta-section" aria-label="Institution partnership CTA">
  <div class="container">
    <div class="cta-box">
      <h2>Partner with MockOrbit</h2>
      <p>Give your students access to structured mock tests. Our institution dashboard lets you assign tests, track performance, and identify students who need extra support — all for free.</p>
      <div class="cta-btns">
        <a href="/org/register" class="btn btn-primary btn-lg">Register Your Institute</a>
        <a href="/contact" class="btn btn-outline btn-lg" style="border-color:rgba(255,255,255,0.3); color:white;">Talk to Us</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

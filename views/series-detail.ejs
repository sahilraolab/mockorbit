<%- include('partials/header') %>

<section class="section">
  <div class="container-sm">
    <a href="/series/exam/<%= series.examId.slug %>" class="text-small text-muted">← <%= series.examId.name %></a>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-error mt-4">⚠️ <%= error[0] %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
      <div class="alert alert-success mt-4">✓ <%= success[0] %></div>
    <% } %>

    <div class="mt-4 mb-6">
      <span class="badge badge-blue mb-3"><%= series.examId.name %></span>
      <h1 style="font-size: 2rem;"><%= series.title %></h1>
      <% if (series.description) { %><p class="mt-3"><%= series.description %></p><% } %>
    </div>

    <!-- Details card -->
    <div class="card mb-6">
      <div class="flex-between mb-4">
        <div>
          <% if (series.price === 0) { %>
            <div class="price" style="color:var(--success);">Free</div>
            <div class="price-note">Full access — no payment needed</div>
          <% } else { %>
            <div class="price"><span class="price-currency">₹</span><%= series.price.toLocaleString('en-IN') %></div>
            <div class="price-note">One-time payment · Lifetime access</div>
          <% } %>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
          <span class="badge badge-green"><%= series.totalMocks %> Full-Length Mock<%= series.totalMocks > 1 ? 's' : '' %></span>
          <% if (series.mockLanguages && series.mockLanguages.length > 0) { %>
            <span style="font-size:0.75rem;color:var(--ink-muted);">
              🌐 Available in <%= series.mockLanguages.join(' · ') %>
            </span>
          <% } %>
        </div>
      </div>

      <% if (series.features && series.features.length > 0) { %>
      <ul class="feature-list mb-6">
        <% series.features.forEach(f => { %><li><%= f %></li><% }) %>
      </ul>
      <% } %>

      <% if (hasPurchased) { %>
        <a href="/dashboard" class="btn btn-success btn-lg btn-block">Go to Dashboard →</a>
      <% } else if (series.price === 0) { %>
        <form method="POST" action="/payment/free-access/<%= series._id %>" style="margin:0;">
          <button type="submit" class="btn btn-success btn-lg btn-block">Access Now — Free →</button>
        </form>
      <% } else { %>
        <a href="/payment/checkout/<%= series._id %>" class="btn btn-primary btn-lg btn-block">Buy Now — ₹<%= series.price.toLocaleString('en-IN') %></a>
        <p class="trust-text mt-3">🔒 Secure payment · Instant access</p>
      <% } %>
    </div>

    <!-- Preview questions -->
    <% if (series.previewQuestions && series.previewQuestions.length > 0) { %>
      <div class="mb-6">
        <h3 class="mb-4" style="font-family: 'DM Sans', sans-serif;">Sample Questions</h3>
        <% series.previewQuestions.slice(0, 3).forEach((pq, idx) => { %>
          <div class="card mb-4">
            <div class="question-number">Question <%= idx + 1 %></div>
            <div class="question-text"><%= pq.question %></div>
            <div class="options-grid">
              <% ['A','B','C','D'].forEach((letter, i) => { %>
                <div class="option-btn" style="cursor: default;">
                  <span class="option-label"><%= letter %></span>
                  <span><%= pq.options[i] %></span>
                </div>
              <% }) %>
            </div>
            <div class="alert alert-info mt-4">
              <strong>Answer: Option <%= ['A','B','C','D'][pq.correctAnswer] %></strong>
              <% if (pq.explanation) { %> — <%= pq.explanation %><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <p class="trust-text">⭐ Trusted by thousands of students preparing for <%= series.examId.name %></p>

    <!-- Reviews: accordion like sample questions -->
    <% if (seriesReviews && seriesReviews.length > 0) { %>
    <div class="mb-6">
      <div class="sample-accord">
        <button class="sample-accord-btn" onclick="toggleSampleAccord(this)">
          <span>Student Reviews (<%= seriesReviews.length %>)</span>
          <span class="sample-accord-chevron">▼</span>
        </button>
        <div class="sample-accord-body">
          <div style="display:flex; flex-direction:column; gap:12px; padding:4px 0 8px;">
            <% seriesReviews.forEach(r => { %>
              <div style="padding:14px 16px; background:var(--canvas-soft); border-radius:var(--radius); border:1px solid var(--border);">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:6px;">
                  <div style="width:28px;height:28px;border-radius:50%;background:var(--accent);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.78rem;flex-shrink:0;"><%= r.name[0].toUpperCase() %></div>
                  <div style="flex:1;">
                    <div style="font-weight:600; font-size:0.88rem; color:var(--ink);"><%= r.name %></div>
                    <% if (r.role) { %><div style="font-size:0.7rem; color:var(--ink-muted);"><%= r.role %></div><% } %>
                  </div>
                  <div style="color:#f59e0b; font-size:0.8rem;"><%= '★'.repeat(r.rating) %></div>
                </div>
                <p style="font-size:0.85rem; color:var(--ink-soft); line-height:1.55; font-style:italic; margin:0;">"<%= r.text %>"</p>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (hasPurchased) { %>
      <p class="trust-text" style="margin-top:4px;">
        ✍️ Reviewed this series?
        <a href="/dashboard#reviewSection" style="color:var(--accent);">Go to Dashboard to leave a review →</a>
      </p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>

<script>
function toggleSampleAccord(btn) {
  const body = btn.nextElementSibling;
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open', !isOpen);
  btn.classList.toggle('open', !isOpen);
}
</script>

            <div class="about-stat-label">Selection Rate</div>
          </div>
        </div>
      </div>
      <div class="about-split-visual" aria-hidden="true">
        <div class="about-visual-card">
          <div class="about-visual-icon">🎯</div>
          <div class="about-visual-title">Focused Practice</div>
          <div class="about-visual-desc">Questions aligned to the exact pattern of your target exam</div>
        </div>
        <div class="about-visual-card">
          <div class="about-visual-icon">📊</div>
          <div class="about-visual-title">Smart Analytics</div>
